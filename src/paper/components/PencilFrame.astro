---
/**
 * PencilFrame — a simple straight thin rule inset from all four edges of
 * the page, in a muted ink tone (--edge). Aman decided against a pencil-line
 * PNG (19 Aug 2026, see Paper/DECISIONS.md) — this used to draw a CSS
 * wobbly bezier line as a stand-in for a scanned asset that never arrived;
 * now it's the deliberate, permanent look. The auto-upgrade path stays: if
 * a border image ever lands in `public/paper/borders/`, this still switches
 * to it automatically, no code change needed.
 *
 * Fixed overlay, does not affect page layout or intercept clicks.
 */
import fs from 'node:fs';
import path from 'node:path';

const bordersDir = path.resolve('public/paper/borders');
let borderFile: string | null = null;
try {
  const files = fs.readdirSync(bordersDir).filter((f) => /\.(png|webp|jpg|jpeg)$/i.test(f));
  if (files.length > 0) borderFile = `/paper/borders/${files[0]}`;
} catch {
  borderFile = null;
}
---

<div
  class="pencil-frame"
  data-lab-id="global.pencil-frame"
  data-lab-kind="free"
  data-lab-label="Pencil border"
  data-lab-group="Global"
  data-lab-props="opacity,color"
  data-lab-asset="borders"
  aria-hidden="true"
>
  {
    borderFile ? (
      <>
        <img class="pencil-edge edge-top" src={borderFile} alt="" />
        <img class="pencil-edge edge-bottom" src={borderFile} alt="" />
        <img class="pencil-edge edge-left" src={borderFile} alt="" />
        <img class="pencil-edge edge-right" src={borderFile} alt="" />
      </>
    ) : (
      <>
        <span class="pencil-edge edge-top" />
        <span class="pencil-edge edge-bottom" />
        <span class="pencil-edge edge-left" />
        <span class="pencil-edge edge-right" />
      </>
    )
  }
</div>

<style>
  .pencil-frame {
    position: fixed;
    inset: 0;
    z-index: 40;
    pointer-events: none;
    opacity: 0.5;
  }

  /* Straight-rule fallback: a single hairline inset from each edge. */
  span.pencil-edge {
    position: absolute;
    display: block;
    background: var(--edge);
  }

  span.edge-top,
  span.edge-bottom {
    left: 28px;
    right: 28px;
    height: 1px;
  }
  span.edge-top {
    top: 28px;
  }
  span.edge-bottom {
    bottom: 28px;
  }

  span.edge-left,
  span.edge-right {
    top: 28px;
    bottom: 28px;
    width: 1px;
  }
  span.edge-left {
    left: 28px;
  }
  span.edge-right {
    right: 28px;
  }

  .pencil-edge {
    position: absolute;
    display: block;
  }

  img.pencil-edge.edge-top,
  img.pencil-edge.edge-bottom {
    width: 100%;
    height: 18px;
    object-fit: cover;
  }
  img.pencil-edge.edge-left,
  img.pencil-edge.edge-right {
    height: 100%;
    width: 18px;
    object-fit: cover;
  }
  img.edge-top {
    top: 0;
    left: 0;
  }
  img.edge-bottom {
    bottom: 0;
    left: 0;
    transform: scaleY(-1);
  }
  img.edge-left {
    top: 0;
    left: 0;
  }
  img.edge-right {
    top: 0;
    right: 0;
    transform: scaleX(-1);
  }
</style>
