---
/**
 * GraphPaper — a faint blue-grid graph-paper backdrop, the surface the
 * papercraft desk photo "sits on" in the mockup. Decorative only.
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<div class:list={['graph-paper', className]} aria-hidden="true"></div>

<style>
  .graph-paper {
    position: absolute;
    inset: 0;
    background-color: #faf7ee;
    background-image:
      linear-gradient(rgba(60, 90, 130, 0.14) 1px, transparent 1px),
      linear-gradient(90deg, rgba(60, 90, 130, 0.14) 1px, transparent 1px),
      linear-gradient(rgba(60, 90, 130, 0.28) 1px, transparent 1px),
      linear-gradient(90deg, rgba(60, 90, 130, 0.28) 1px, transparent 1px);
    background-size: 16px 16px, 16px 16px, 80px 80px, 80px 80px;
    border-radius: inherit;
  }
</style>
