---
/**
 * Hero — deep-green textured-paper hero with a large sans... no, serif
 * Didone heading, Aman's photo, and a cut-paper cloud landscape.
 *
 * Contains the spec's required variant-toggle pair: hero.title renders
 * twice, once as live text and once as an <img> of the letterpress art,
 * sharing data-lab-variant-of="hero.title". The image is hidden by default
 * (class="lab-variant-hidden") — Track B's editor toggles visibility.
 */

import PaperPhoto from '../components/PaperPhoto.astro';

const base = import.meta.env.BASE_URL;
const baseSlash = base.endsWith('/') ? base : base + '/';
---

<section
  id="hero"
  class="paper-hero"
  data-lab-id="hero"
  data-lab-kind="flow"
  data-lab-label="Hero section"
  data-lab-group="Hero"
  data-lab-props="paddingTop,paddingBottom,background,maxWidth"
  data-lab-asset="backgrounds"
>
  <div class="hero-inner">
    <div class="hero-copy">

      <h1
        class="hero-title"
        data-lab-id="hero.title"
        data-lab-kind="flow"
        data-lab-label="Hero heading (text)"
        data-lab-group="Hero"
        data-lab-props="fontSize,letterSpacing,lineHeight,color,align,marginTop,marginBottom,maxWidth,font"
        data-lab-variant-of="hero.title"
      >
        Hi, I am Aman
      </h1>

      <img
        class="hero-title-image lab-variant-hidden"
        data-lab-id="hero.title.image"
        data-lab-kind="flow"
        data-lab-label="Hero heading (image)"
        data-lab-group="Hero"
        data-lab-props="maxWidth,marginTop,marginBottom,align,opacity"
        data-lab-variant-of="hero.title"
        data-lab-asset="text"
        src={`${baseSlash}paper/text/advercase-letterpress.png`}
        alt="Hi, I am Aman"
      />

      <p
        class="hero-subtitle"
        data-lab-id="hero.subtitle"
        data-lab-kind="flow"
        data-lab-label="Hero subheading"
        data-lab-group="Hero"
        data-lab-props="fontSize,letterSpacing,lineHeight,color,align,marginTop,marginBottom,maxWidth,font"
      >
        Strategy generalist and AI builder.<br />Figuring out the rest.
      </p>

      <!-- 20 Aug 2026 (queue): hero CTA row removed. -->

      <!-- 20 Aug 2026 (queue r2): engineering-grid layer behind the photo
           removed. -->
      <div class="hero-photo-wrap">
        <PaperPhoto
          src={`${baseSlash}paper/photos/aman-headshot.webp`}
          alt="Aman Beniwal"
          width="206px"
          size="small"
          seed="hero-aman"
          frame="polaroid"
          labId="hero.photo"
          labLabel="Aman's photo"
          labGroup="Hero"
        />
      </div>
    </div>

  </div>

  <!-- 26 Aug 2026: golden-ratio spiral decor removed (Aman's request) along
       with the diorama it sat behind — the taped spreadsheet stands alone. -->

  <!-- 26 Aug 2026: circle-meet starburst, recoloured brown → cream (matches
       --paper-hero-ink), tucked into the bottom-left corner of the panel. -->
  <img
    class="hero-starburst"
    src={`${baseSlash}paper/decor/circle-meet-cream.webp`}
    alt=""
    aria-hidden="true"
  />

  <div class="hero-side">
    <PaperPhoto
      src={`${baseSlash}paper/objects/xlscr.webp`}
      alt="A spreadsheet about Aman — role, location, what he's looking for, and what drives him"
      width="100%"
      size="large"
      seed="hero-spreadsheet"
      tapeMatch
      labId="hero.spreadsheet"
      labLabel="About-me spreadsheet"
      labGroup="Hero"
    />
  </div>

</section>

<div class="hero-endstrip" data-lab-id="hero.endstrip" data-lab-kind="flow"
  data-lab-label="Strip below hero" data-lab-group="Hero"
  data-lab-props="paddingTop,paddingBottom,background">
</div>

<style>
  .paper-hero {
    position: relative;
    overflow: hidden;
    /* 20 Aug 2026 (queue): terracotta background, swapped off the shared
       green hero tokens (Contact keeps those). */
    background-color: var(--paper-terracotta-tint);
    background-image: var(--paper-terracotta-bg);
    background-size: cover;
    background-position: center;
    /* Copy sits lower in the panel. The green still has to fit inside one
       viewport including the sticky top bar, so the bottom padding stays
       tight while the top does the work. */
    padding-block: 110px 70px;
    /* 20 Aug 2026 (queue r3): min-height reverted to a fixed 460px — the
       85vh change (queue r2) was a mistake per Aman; original was right. */
    min-height: 460px;
    border-bottom: 1px solid var(--rule);
    color: var(--paper-hero-ink);
  }

  /* Grain overlay over the hero art — irregular fractal noise, driven by
     --grain. Soft-light instead of multiply here since the ground is dark:
     multiplying black noise onto near-black paper would barely register. */
  .paper-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: var(--grain-hero);
    background-image: var(--grain-texture);
    background-size: var(--grain-size) var(--grain-size);
    mix-blend-mode: soft-light;
  }

  /* 19 Aug 2026 (execution round): text column plus a small side column for
     the renewables diorama (change 4). Aman's photo stays in the copy
     column, pulled up tight under the subtitle (change 1). */
  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 1180px;
    margin-inline: auto;
    padding-inline: 24px;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
  }



  .hero-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(40px, 6vw, 72px);
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin: 0 0 16px;
    color: var(--paper-hero-ink);
    text-shadow: var(--letterpress-ondark);
  }

  .hero-title-image {
    max-width: 460px;
    width: 100%;
    height: auto;
    display: block;
    margin: 0 0 18px;
  }

  .lab-variant-hidden {
    display: none;
  }

  .hero-subtitle {
    font-family: var(--font-body);
    /* 20 Aug 2026 (queue r2): 16px read too small — bumped to 20px, with a
       touch more line-height for comfort at the larger size. */
    font-size: 20px;
    line-height: 1.55;
    color: rgba(244, 239, 224, 0.8);
    max-width: none;
    margin: 0;
  }

  /* 20 Aug 2026 (queue): .hero-cta-row / .hero-cta / .hero-cta:hover
     removed along with the CTA markup above. */

  /* 19 Aug 2026 (execution round): pulled tight against the subtitle above
     it (change 1) — was a 32px gap between the whole copy block and the
     photo; now a small margin directly on the wrap. */
  .hero-photo-wrap {
    position: relative;
    justify-self: start;
    /* Moved a bit lower in the panel (queue, 20 Aug). */
    margin-top: 44px;
  }

  /* 26 Aug 2026 (Aman's request): nudge the photo (+ its tape, since the tape
     is part of the same figure) right and slightly up on desktop. Relative
     offset, not a layout change, so the copy column keeps its footprint.
     Desktop-only — mobile centres the photo and shouldn't inherit this. */
  @media (min-width: 861px) {
    .hero-photo-wrap {
      left: 48px;
      top: -22px;
    }
  }

  .hero-photo {
    /* 20 Aug 2026 (queue r3): +20% over the previous 172px (item 36). */
    width: 206px;
    height: 206px;
    object-fit: cover;
    object-position: top center;
    background: #eee6d4;
    /* 19 Aug 2026: white photo-frame border removed (change 2). */
    border: none;
  }

  /* Renewables diorama. Positioned to the spot Aman outlined in red: right
     hand side, starting below the headline and running to roughly two thirds
     of the hero's height. Absolute rather than a flex column so it lands
     exactly there instead of being pushed around by the copy beside it.
     Yellow studio background left exactly as photographed, on request. */
  /* Same slim band as the one at the top of the page, closing the green
     panel off the way the reference site closes its hero. */
  /* Sits under the green, same height as the band above the menu bar and as
     the side margins are wide. */
  .hero-endstrip {
    height: var(--page-inset);
    border-bottom: 1px solid var(--rule);
  }

  /* 26 Aug 2026: grown 34% → 44% → 48% (+10% again, Aman's request) — the
     spreadsheet screenshot carries text, so it read too small at the old
     diorama size. Shifted left (52% → 46%) so it clears the right frame
     border with real breathing room instead of crowding it. Nudged up
     (24% → 15%) per Aman's request. */
  .hero-side {
    position: absolute;
    left: 46%;
    top: 15%;
    width: 48%;
    z-index: 1;
  }

  /* 26 Aug 2026: cream starburst, bottom-left corner of the hero panel,
     behind everything (z-index 0). Section clips overflow so it can't spill. */
  .hero-starburst {
    position: absolute;
    left: -6%;
    bottom: -10%;
    width: 30%;
    opacity: 0.5;
    z-index: 0;
    pointer-events: none;
  }

  /* Keep the photo above its litho backing. */
  .hero-photo-wrap .paper-photo {
    position: relative;
    z-index: 1;
  }

  /* 26 Aug 2026: stronger paper-lift shadow on the spreadsheet specifically —
     the white sheet needs more separation from the terracotta ground than
     PaperPhoto's default (tuned for photos, which already have tonal
     contrast). Same light-from-top-left language, just deeper. */
  .hero-side :global(.paper-photo-img) {
    box-shadow:
      4px 6px 10px rgba(20, 12, 6, 0.38),
      14px 22px 40px rgba(20, 12, 6, 0.3);
  }

  @media (max-width: 860px) {
    .paper-hero {
      padding-block: 32px 28px;
    }
    .hero-inner {
      flex-direction: column;
    }
    .hero-side {
      position: static;
      width: 240px;
      max-width: 62vw;
      margin-top: 28px;
    }
    /* 26 Aug 2026: a <figure> carries a UA default margin-inline:40px that
       PaperPhoto never resets — harmless when the object floated on desktop,
       but it shoves the centred spreadsheet 40px right (past the frame) once
       it stacks. Zero it here so the taped sheet centres cleanly. */
    .hero-side :global(.paper-photo) {
      margin-inline: 0;
    }
  }

  /* 20 Aug 2026 (mobile): phone pass. Tightens the vertical rhythm (this
     section was stacking photo-over-diorama into a very tall scroll on
     small screens), shrinks the side diorama + its tape (sized for the
     desktop panel), and dials the decorative spiral back so it reads as a
     quiet backdrop instead of competing with the copy. */
  @media (max-width: 767px) {
    .paper-hero {
      padding-block: 28px 24px;
    }
    .hero-inner {
      padding-inline: 16px;
      gap: 16px;
    }
    .hero-subtitle {
      font-size: 17px;
    }
    /* 24 Aug 2026 (mobile queue): Aman's headshot read too big next to the
       diorama on phones. Shrink it and centre it in the column. !important
       beats PaperPhoto's inline width. */
    .hero-photo-wrap {
      margin-top: 24px;
      text-align: center;
    }
    .hero-photo-wrap :global(.paper-photo) {
      width: 150px !important;
    }
    /* 24 Aug 2026 (mobile queue): grow the side object so it reads as the
       larger hero object. 26 Aug: it's now the spreadsheet screenshot, so it's
       sized a little larger again for the small text to stay legible. */
    .hero-side {
      width: 300px;
      max-width: 88vw;
      margin-inline: auto;
      margin-top: 20px;
    }
    /* 24 Aug 2026 (mobile queue): tape caps removed — the constant site-wide
       tape size now lives in PaperPhoto.astro, so every photo matches. */
  }

  /* 20 Aug 2026 (mobile): 480px and below (incl. 375/320 targets) — the
     260px-wide diorama still reads big next to a 320-375px viewport, so it
     comes down further along with its tape, and the hero's vertical padding
     tightens once more. */
  @media (max-width: 480px) {
    .paper-hero {
      padding-block: 24px 20px;
    }
    .hero-inner {
      padding-inline: 12px;
    }
    .hero-photo-wrap {
      margin-top: 20px;
    }
    .hero-photo-wrap :global(.paper-photo) {
      width: 132px !important;
    }
    .hero-side {
      width: 300px;
      max-width: 90vw;
      margin-top: 16px;
    }
  }
</style>
