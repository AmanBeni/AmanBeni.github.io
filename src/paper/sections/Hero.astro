---
/**
 * Hero — deep-green textured-paper hero with a large sans... no, serif
 * Didone heading, Aman's photo, and a cut-paper cloud landscape.
 *
 * Contains the spec's required variant-toggle pair: hero.title renders
 * twice, once as live text and once as an <img> of the letterpress art,
 * sharing data-lab-variant-of="hero.title". The image is hidden by default
 * (class="lab-variant-hidden") — Track B's editor toggles visibility.
 */
import TapeStrip from '../components/TapeStrip.astro';

const base = import.meta.env.BASE_URL;
const baseSlash = base.endsWith('/') ? base : base + '/';
---

<section
  id="hero"
  class="paper-hero"
  data-lab-id="hero"
  data-lab-kind="flow"
  data-lab-label="Hero section"
  data-lab-group="Hero"
  data-lab-props="paddingTop,paddingBottom,background,maxWidth"
  data-lab-asset="backgrounds"
>
  <div class="hero-inner">
    <div class="hero-copy">
      <p
        class="hero-chip"
        data-lab-id="hero.chip"
        data-lab-kind="flow"
        data-lab-label="Status chip"
        data-lab-group="Hero"
        data-lab-props="fontSize,letterSpacing,color,marginBottom"
      >
        <span class="hero-chip-dot" aria-hidden="true"></span>
        SYSTEM_ONLINE &middot; JAIPUR, IN
      </p>

      <h1
        class="hero-title"
        data-lab-id="hero.title"
        data-lab-kind="flow"
        data-lab-label="Hero heading (text)"
        data-lab-group="Hero"
        data-lab-props="fontSize,letterSpacing,lineHeight,color,align,marginTop,marginBottom,maxWidth,font"
        data-lab-variant-of="hero.title"
      >
        Hi, I am Aman
      </h1>

      <img
        class="hero-title-image lab-variant-hidden"
        data-lab-id="hero.title.image"
        data-lab-kind="flow"
        data-lab-label="Hero heading (image)"
        data-lab-group="Hero"
        data-lab-props="maxWidth,marginTop,marginBottom,align,opacity"
        data-lab-variant-of="hero.title"
        data-lab-asset="text"
        src={`${baseSlash}paper/text/advercase-letterpress.png`}
        alt="Hi, I am Aman"
      />

      <p
        class="hero-subtitle"
        data-lab-id="hero.subtitle"
        data-lab-kind="flow"
        data-lab-label="Hero subheading"
        data-lab-group="Hero"
        data-lab-props="fontSize,letterSpacing,lineHeight,color,align,marginTop,marginBottom,maxWidth,font"
      >
        Strategy generalist and AI builder. Figuring out the rest.
      </p>
    </div>

    <div class="hero-photo-wrap">
      <img
        class="hero-photo"
        data-lab-id="hero.photo"
        data-lab-kind="flow"
        data-lab-label="Aman's photo"
        data-lab-group="Hero"
        data-lab-props="maxWidth,rotate,shadow,marginTop,marginBottom"
        data-lab-asset="photos"
        src={`${baseSlash}paper/photos/aman-headshot.webp`}
        alt="Aman Beniwal"
      />
      <TapeStrip rotate={0} tone="kraft" class="hero-photo-tape" />
    </div>
  </div>

  <div class="hero-side">
    <img
      class="hero-renewables"
      data-lab-id="hero.renewables"
      data-lab-kind="flow"
      data-lab-label="Renewables diorama"
      data-lab-group="Hero"
      data-lab-props="maxWidth,marginTop,marginBottom"
      data-lab-asset="objects"
      src={`${baseSlash}paper/objects/renewables-diorama.webp`}
      alt="Papercraft diorama of wind turbines and solar panels on a green landform"
      loading="lazy"
    />
  </div>

  <!-- Free-floating collage layer: the cut-paper cloud landscape sits here,
       draggable/rescalable independent of the flow copy above it. -->
  <div class="hero-canvas" data-lab-canvas aria-hidden="false">
    <div
      class="hero-cloudscape"
      data-lab-id="hero.cloudscape"
      data-lab-kind="free"
      data-lab-label="Cloud landscape"
      data-lab-group="Hero"
      data-lab-props="x,y,rotate,scale,z,opacity,shadow"
    >
      <svg viewBox="0 0 600 340" preserveAspectRatio="xMidYMid slice" role="img" aria-label="Cut-paper cloud landscape">
        <rect width="600" height="340" fill="#bfe0ea" />
        <g fill="#f4efe4" opacity="0.96">
          <ellipse cx="120" cy="90" rx="70" ry="34" />
          <ellipse cx="175" cy="72" rx="46" ry="28" />
          <ellipse cx="70" cy="80" rx="42" ry="24" />
        </g>
        <g fill="#f4efe4" opacity="0.88">
          <ellipse cx="430" cy="60" rx="60" ry="28" />
          <ellipse cx="480" cy="78" rx="40" ry="22" />
        </g>
        <path d="M0,340 L0,230 C90,190 140,250 230,210 C320,175 380,235 470,205 C520,188 560,215 600,200 L600,340 Z" fill="#a9754a" />
        <path d="M0,340 L0,270 C120,250 220,290 320,260 C420,232 500,270 600,250 L600,340 Z" fill="#8a5e3a" />
      </svg>
    </div>
  </div>
</section>

<style>
  .paper-hero {
    position: relative;
    overflow: hidden;
    background-color: var(--paper-hero-tint);
    background-image: var(--paper-hero-bg);
    background-size: cover;
    background-position: center;
    /* 19 Aug 2026 (execution round): cut well over 40% further from the
       84px/91px this already carried — the green panel must fit inside one
       viewport including the sticky top bar. */
    padding-block: 40px 40px;
    border-bottom: 1px solid var(--rule);
    color: var(--paper-hero-ink);
  }

  /* Grain overlay over the hero art — irregular fractal noise, driven by
     --grain. Soft-light instead of multiply here since the ground is dark:
     multiplying black noise onto near-black paper would barely register. */
  .paper-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: calc(var(--grain) * 0.9);
    background-image: var(--grain-texture);
    background-size: var(--grain-size) var(--grain-size);
    mix-blend-mode: soft-light;
  }

  /* 19 Aug 2026 (execution round): text column plus a small side column for
     the renewables diorama (change 4). Aman's photo stays in the copy
     column, pulled up tight under the subtitle (change 1). */
  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 1180px;
    margin-inline: auto;
    padding-inline: 24px;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
  }

  .hero-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    width: fit-content;
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.1em;
    color: rgba(244, 239, 224, 0.7);
    margin: 0 0 16px;
  }

  .hero-chip-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #d9a441;
  }

  .hero-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(40px, 6vw, 72px);
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin: 0 0 16px;
    color: var(--paper-hero-ink);
    text-shadow: var(--letterpress-ondark);
  }

  .hero-title-image {
    max-width: 460px;
    width: 100%;
    height: auto;
    display: block;
    margin: 0 0 18px;
  }

  .lab-variant-hidden {
    display: none;
  }

  .hero-subtitle {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.5;
    color: rgba(244, 239, 224, 0.8);
    max-width: 40ch;
    margin: 0;
  }

  /* 19 Aug 2026 (execution round): pulled tight against the subtitle above
     it (change 1) — was a 32px gap between the whole copy block and the
     photo; now a small margin directly on the wrap. */
  .hero-photo-wrap {
    position: relative;
    justify-self: start;
    margin-top: 18px;
  }

  .hero-photo {
    width: 150px;
    height: 150px;
    object-fit: cover;
    object-position: top center;
    background: #eee6d4;
    /* 19 Aug 2026: white photo-frame border removed (change 2). */
    border: none;
  }

  .hero-photo-tape {
    position: absolute;
    top: -14px;
    left: 50%;
    transform: translateX(-50%);
  }

  /* Renewables diorama (change 4) — small, straight, sits opposite the copy
     column. No border/shadow/rotation, and no colour treatment: its yellow
     background is left as photographed. Sized so it never forces the hero
     taller than the copy column beside it. */
  .hero-side {
    flex: none;
    align-self: flex-start;
    margin-top: 4px;
  }

  .hero-renewables {
    display: block;
    width: 190px;
    max-width: 32vw;
    height: auto;
    border: none;
    box-shadow: none;
    transform: none;
  }

  .hero-canvas {
    position: relative;
    z-index: 1;
    max-width: 1180px;
    margin: 32px auto 0;
    padding-inline: 24px;
    height: clamp(80px, 11vw, 150px);
  }

  .hero-cloudscape {
    position: absolute;
    left: 4%;
    right: 4%;
    bottom: 0;
    height: 100%;
    /* 19 Aug 2026: white photo-frame border removed (change 2). */
    border: none;
    overflow: hidden;
    border-radius: 2px;
  }

  .hero-cloudscape svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  @media (max-width: 860px) {
    .paper-hero {
      padding-block: 32px 28px;
    }
    .hero-inner {
      flex-direction: column;
    }
    .hero-side {
      align-self: flex-start;
      margin-top: 20px;
    }
    .hero-renewables {
      width: 150px;
      max-width: 45vw;
    }
    .hero-canvas {
      margin-top: 24px;
    }
  }
</style>
