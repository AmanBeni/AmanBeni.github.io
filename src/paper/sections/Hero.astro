---
/**
 * Hero — deep-green textured-paper hero with a large sans... no, serif
 * Didone heading, Aman's photo, and a cut-paper cloud landscape.
 *
 * Contains the spec's required variant-toggle pair: hero.title renders
 * twice, once as live text and once as an <img> of the letterpress art,
 * sharing data-lab-variant-of="hero.title". The image is hidden by default
 * (class="lab-variant-hidden") — Track B's editor toggles visibility.
 */

const base = import.meta.env.BASE_URL;
const baseSlash = base.endsWith('/') ? base : base + '/';
---

<section
  id="hero"
  class="paper-hero"
  data-lab-id="hero"
  data-lab-kind="flow"
  data-lab-label="Hero section"
  data-lab-group="Hero"
  data-lab-props="paddingTop,paddingBottom,background,maxWidth"
  data-lab-asset="backgrounds"
>
  <div class="hero-inner">
    <div class="hero-copy">

      <h1
        class="hero-title"
        data-lab-id="hero.title"
        data-lab-kind="flow"
        data-lab-label="Hero heading (text)"
        data-lab-group="Hero"
        data-lab-props="fontSize,letterSpacing,lineHeight,color,align,marginTop,marginBottom,maxWidth,font"
        data-lab-variant-of="hero.title"
      >
        Hi, I am Aman
      </h1>

      <img
        class="hero-title-image lab-variant-hidden"
        data-lab-id="hero.title.image"
        data-lab-kind="flow"
        data-lab-label="Hero heading (image)"
        data-lab-group="Hero"
        data-lab-props="maxWidth,marginTop,marginBottom,align,opacity"
        data-lab-variant-of="hero.title"
        data-lab-asset="text"
        src={`${baseSlash}paper/text/advercase-letterpress.png`}
        alt="Hi, I am Aman"
      />

      <p
        class="hero-subtitle"
        data-lab-id="hero.subtitle"
        data-lab-kind="flow"
        data-lab-label="Hero subheading"
        data-lab-group="Hero"
        data-lab-props="fontSize,letterSpacing,lineHeight,color,align,marginTop,marginBottom,maxWidth,font"
      >
        Strategy generalist and AI builder.<br />Figuring out the rest.
      </p>

      <div class="hero-photo-wrap">
        <img
          class="hero-photo"
          data-lab-id="hero.photo"
          data-lab-kind="flow"
          data-lab-label="Aman's photo"
          data-lab-group="Hero"
          data-lab-props="maxWidth,rotate,shadow,marginTop,marginBottom"
          data-lab-asset="photos"
          src={`${baseSlash}paper/photos/aman-headshot.webp`}
          alt="Aman Beniwal"
        />
      </div>
    </div>

  </div>

  <div class="hero-side">
    <img
      class="hero-renewables"
      data-lab-id="hero.renewables"
      data-lab-kind="flow"
      data-lab-label="Renewables diorama"
      data-lab-group="Hero"
      data-lab-props="maxWidth,marginTop,marginBottom"
      data-lab-asset="objects"
      src={`${baseSlash}paper/objects/renewables-diorama.webp`}
      alt="Papercraft diorama of wind turbines and solar panels on a green landform"
      loading="lazy"
    />
  </div>

</section>

<style>
  .paper-hero {
    position: relative;
    overflow: hidden;
    background-color: var(--paper-hero-tint);
    background-image: var(--paper-hero-bg);
    background-size: cover;
    background-position: center;
    /* Copy sits lower in the panel. The green still has to fit inside one
       viewport including the sticky top bar, so the bottom padding stays
       tight while the top does the work. */
    padding-block: 110px 70px;
    min-height: 600px;
    border-bottom: 1px solid var(--rule);
    color: var(--paper-hero-ink);
  }

  /* Grain overlay over the hero art — irregular fractal noise, driven by
     --grain. Soft-light instead of multiply here since the ground is dark:
     multiplying black noise onto near-black paper would barely register. */
  .paper-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: var(--grain-hero);
    background-image: var(--grain-texture);
    background-size: var(--grain-size) var(--grain-size);
    mix-blend-mode: soft-light;
  }

  /* 19 Aug 2026 (execution round): text column plus a small side column for
     the renewables diorama (change 4). Aman's photo stays in the copy
     column, pulled up tight under the subtitle (change 1). */
  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 1180px;
    margin-inline: auto;
    padding-inline: 24px;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
  }



  .hero-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(40px, 6vw, 72px);
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin: 0 0 16px;
    color: var(--paper-hero-ink);
    text-shadow: var(--letterpress-ondark);
  }

  .hero-title-image {
    max-width: 460px;
    width: 100%;
    height: auto;
    display: block;
    margin: 0 0 18px;
  }

  .lab-variant-hidden {
    display: none;
  }

  .hero-subtitle {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.5;
    color: rgba(244, 239, 224, 0.8);
    max-width: none;
    margin: 0;
  }

  /* 19 Aug 2026 (execution round): pulled tight against the subtitle above
     it (change 1) — was a 32px gap between the whole copy block and the
     photo; now a small margin directly on the wrap. */
  .hero-photo-wrap {
    position: relative;
    justify-self: start;
    margin-top: 18px;
  }

  .hero-photo {
    /* 15% larger than the 150px it carried before. */
    width: 172px;
    height: 172px;
    object-fit: cover;
    object-position: top center;
    background: #eee6d4;
    /* 19 Aug 2026: white photo-frame border removed (change 2). */
    border: none;
  }

  /* Renewables diorama. Positioned to the spot Aman outlined in red: right
     hand side, starting below the headline and running to roughly two thirds
     of the hero's height. Absolute rather than a flex column so it lands
     exactly there instead of being pushed around by the copy beside it.
     Yellow studio background left exactly as photographed, on request. */
  /* Same slim band as the one at the top of the page, closing the green
     panel off the way the reference site closes its hero. */
  .hero-endstrip {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 34px;
    border-top: 1px solid var(--rule);
    z-index: 2;
  }

  .hero-side {
    position: absolute;
    left: 57%;
    top: 34%;
    width: 30%;
    z-index: 1;
  }

  .hero-renewables {
    display: block;
    width: 100%;
    height: auto;
    border: none;
    box-shadow: none;
    transform: none;
  }




  @media (max-width: 860px) {
    .paper-hero {
      padding-block: 32px 28px;
    }
    .hero-inner {
      flex-direction: column;
    }
    .hero-side {
      position: static;
      width: 200px;
      max-width: 55vw;
      margin-top: 28px;
    }
    .hero-renewables {
      width: 150px;
      max-width: 45vw;
    }
  }
</style>
