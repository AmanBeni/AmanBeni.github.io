---
/**
 * Beyond work — books + music, same content as the pixel site's "Beyond
 * Work" section.
 *
 * 20 Aug 2026 (queue): restored the two pixel-site motions — the books
 * "assembly belt" (a continuously scrolling, seamlessly looping marquee) and
 * the draggable/autoplaying song coverflow — and dropped the free-floating
 * armchair object.
 * 20 Aug 2026 (queue r2): Spotify playlist link removed from the music
 * subtitle.
 */
import Coverflow from '../../components/Coverflow.astro';
import onRepeat from '../../data/on-repeat.json';

const base = import.meta.env.BASE_URL;
const baseSlash = base.endsWith('/') ? base : base + '/';

const books = [
  { title: 'Essentialism', author: 'Greg McKeown', cover: 'essentialism.jpg' },
  { title: 'Stillness is the Key', author: 'Ryan Holiday', cover: 'stillness.jpg' },
  { title: 'The Almanack of Naval Ravikant', author: 'Eric Jorgenson', cover: 'almanack-naval.jpg' },
  { title: 'Siddhartha', author: 'Hermann Hesse', cover: 'siddhartha.jpg' },
  { title: 'Zero to Scale', author: 'Arindam Paul', cover: 'zero-to-scale.jpg' },
  { title: 'Zero to One', author: 'Peter Thiel', cover: 'zero-to-one.jpg' },
  { title: 'Man’s Search for Meaning', author: 'Viktor Frankl', cover: 'mans-search.jpg' },
  { title: 'The Money Trap', author: 'Alok Sama', cover: 'money-trap.jpg' },
  { title: 'Clearing the Air', author: 'Hannah Ritchie', cover: 'clearing-the-air.jpg' },
];
const coverBase = baseSlash + 'book-covers/';
const slides = onRepeat.slides as { src: string; title: string; subtitle: string }[];
---

<section
  id="beyond"
  class="paper-beyond"
  data-lab-id="beyond"
  data-lab-kind="flow"
  data-lab-label="Beyond Work section"
  data-lab-group="Beyond"
  data-lab-props="paddingTop,paddingBottom,background,maxWidth"
>
  {/* 20 Aug 2026 (queue r3): still (unanimated) papercraft clouds behind
      the heading, per Paper/References/Lab Files/clouds/reference.png —
      one large cloud near the heading, two smaller ones drifting lower to
      the right. Section already clips overflow so nothing spills. */}
  <img class="beyond-cloud beyond-cloud-hero" src={`${baseSlash}paper/decor/cloud-large.png`} alt="" aria-hidden="true" />
  <img class="beyond-cloud beyond-cloud-wide" src={`${baseSlash}paper/decor/cloud-wide.png`} alt="" aria-hidden="true" />
  <img class="beyond-cloud beyond-cloud-small" src={`${baseSlash}paper/decor/cloud-small.png`} alt="" aria-hidden="true" />

  <div class="beyond-inner">
    <h2
      class="beyond-heading"
      data-lab-id="beyond.heading"
      data-lab-kind="flow"
      data-lab-label="Beyond Work heading"
      data-lab-group="Beyond"
      data-lab-props="fontSize,letterSpacing,color,align,marginBottom,font"
    >
      {/* 20 Aug 2026 (queue r3): capitalised "Work" (item 66). */}
      Beyond Work
    </h2>
    <p
      class="beyond-sub"
      data-lab-id="beyond.subtitle"
      data-lab-kind="flow"
      data-lab-label="Books subtitle"
      data-lab-group="Beyond"
      data-lab-props="fontSize,color,marginBottom,font"
    >
      Books I enjoyed reading and would like to recommend.
    </p>
  </div>

  <!-- Books "assembly belt": covers scroll continuously right→left, looping
       seamlessly (list duplicated; track translates by exactly one copy). -->
  <div
    class="books-marquee"
    data-lab-id="beyond.books"
    data-lab-kind="flow"
    data-lab-label="Books row"
    data-lab-group="Beyond"
    data-lab-props="gap,paddingTop,paddingBottom"
  >
    <ul class="books-track">
      {
        [...books, ...books].map((book, i) => (
          <li class="book-item" aria-hidden={i >= books.length ? 'true' : undefined}>
            <div class="book-cover">
              <img src={`${coverBase}${book.cover}`} alt={`${book.title} cover`} loading="lazy" />
            </div>
            <p class="book-title">{book.title}</p>
            <p class="book-author">{book.author}</p>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="beyond-inner">
    <p
      class="beyond-sub beyond-sub-music"
      data-lab-id="beyond.music-subtitle"
      data-lab-kind="flow"
      data-lab-label="Music subtitle"
      data-lab-group="Beyond"
      data-lab-props="fontSize,color,marginTop,marginBottom,font"
    >
      A small snapshot of what I have been listening to lately.<br />
      These are the top songs live from my Spotify repeat playlist.
    </p>
  </div>

  <div
    class="music-coverflow"
    data-lab-id="beyond.music"
    data-lab-kind="flow"
    data-lab-label="On Repeat playlist row"
    data-lab-group="Beyond"
    data-lab-props="gap,marginTop,maxWidth"
  >
    <Coverflow slides={slides} label="Aman's Spotify | On Repeat" />
  </div>
</section>

<style>
  .paper-beyond {
    position: relative;
    border-bottom: 1px solid var(--rule);
    /* 20 Aug 2026 (queue r10): standard 80px top space (line → heading). */
    padding-block: 80px 96px;
    overflow: hidden;
  }

  .beyond-inner {
    max-width: var(--content-max);
    margin-inline: auto;
    padding-inline: 24px;
    position: relative;
    z-index: 1;
  }

  /* 20 Aug 2026 (queue r3): still papercraft clouds, calm and subtle — a
     soft drop-shadow so each reads as a cut-paper piece resting above the
     paper stock, not a flat sticker. z-index 0 so copy stays legible on
     top; section has overflow:hidden so these can never spill. */
  .beyond-cloud {
    position: absolute;
    z-index: 0;
    pointer-events: none;
    filter: drop-shadow(4px 8px 14px rgba(28, 20, 12, 0.16));
  }

  .beyond-cloud-hero {
    top: -4%;
    left: -3%;
    width: 22%;
    max-width: 300px;
    opacity: 0.92;
  }

  /* 20 Aug 2026 (queue r4): both right-side clouds moved up into the band
     beside the heading, per Aman's marked-up screenshot — the large one in the
     top-right corner, the small one center-right at heading level. */
  .beyond-cloud-wide {
    top: 1%;
    right: -2%;
    width: 26%;
    max-width: 340px;
    opacity: 0.8;
  }

  .beyond-cloud-small {
    top: 9%;
    right: 42%;
    width: 11%;
    max-width: 140px;
    opacity: 0.7;
  }

  @media (max-width: 860px) {
    .beyond-cloud-hero {
      width: 34%;
    }
    .beyond-cloud-wide {
      width: 36%;
      top: 10%;
    }
    .beyond-cloud-small {
      display: none;
    }
  }

  .beyond-heading {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(44px, 6vw, 72px);
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: var(--ink);
    text-shadow: var(--letterpress-onlight);
    mix-blend-mode: multiply;
    margin: 0 0 40px;
  }

  .beyond-sub {
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--ink-soft);
    max-width: 52ch;
    margin: 0;
  }

  /* 20 Aug 2026 (queue r2): more breathing room above the music subtitle,
     below the books belt (was 52px). */
  .beyond-sub-music {
    margin-top: 84px;
  }

  /* Books — continuous single-row marquee ("assembly belt"). Covers fade in
     and out at both edges via the mask. */
  .books-marquee {
    position: relative;
    z-index: 1;
    overflow: hidden;
    width: 100%;
    margin-top: 40px;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }

  .books-track {
    display: flex;
    gap: 28px;
    width: max-content;
    margin: 0;
    padding: 6px 24px;
    list-style: none;
    animation: books-scroll 60s linear infinite;
  }

  /* Pause the belt when someone wants to look. */
  .books-marquee:hover .books-track {
    animation-play-state: paused;
  }

  .book-item {
    flex: none;
    width: 118px;
    margin: 0;
  }

  .book-cover {
    aspect-ratio: 2 / 3;
    border-radius: 3px;
    overflow: hidden;
    background: var(--paper-card);
    margin-bottom: 10px;
  }

  .book-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .book-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 13.5px;
    margin: 0 0 1px;
    color: var(--ink);
    line-height: 1.25;
  }

  .book-author {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--ink-soft);
    margin: 0;
  }

  /* Track is duplicated (books ×2); translating by half its width lands on
     the identical second copy → seamless loop. */
  @keyframes books-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  .music-coverflow {
    max-width: var(--content-max);
    margin: 28px auto 0;
    padding-inline: 24px;
    position: relative;
    z-index: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .books-track {
      animation: none;
    }
    .books-marquee {
      overflow-x: auto;
      -webkit-mask-image: none;
      mask-image: none;
    }
  }

  /* 20 Aug 2026 (mobile): desktop-sized 100px padding trimmed; clouds shrunk
     further than the 860px step so they sit clear of the heading/subtitle
     text on a narrow column instead of crowding it. Marquee/coverflow scroll
     internally already (overflow:hidden + width:100% on the marquee, fixed
     118px book-item cards) so neither causes page-level horizontal scroll. */
  @media (max-width: 767px) {
    .paper-beyond {
      padding-block: 64px 72px;
    }
    .beyond-inner,
    .music-coverflow {
      padding-inline: 20px;
    }
    .beyond-cloud-hero {
      width: 26%;
      max-width: 130px;
      top: -2%;
    }
    .beyond-cloud-wide {
      width: 28%;
      max-width: 150px;
      top: 6%;
    }
    .beyond-sub-music {
      margin-top: 56px;
    }
  }

  /* 20 Aug 2026 (mobile): 375/320px — hide the hero cloud too so nothing
     competes with the heading in a single narrow column. */
  @media (max-width: 480px) {
    .paper-beyond {
      padding-block: 48px 56px;
    }
    .beyond-heading {
      margin-bottom: 24px;
    }
    /* 24 Aug 2026 (mobile queue): two clouds, cascading down the right edge
       (the heading is left-aligned and fills the width, so the clear sky is
       on the right). Wide cloud sits in the top-right corner by the heading;
       the second drifts lower-right in the band below the subtitle, clear of
       the books row. */
    .beyond-cloud-wide {
      width: 30%;
      max-width: 124px;
      top: 1%;
      right: -3%;
      opacity: 0.78;
    }
    .beyond-cloud-hero {
      display: block;
      width: 24%;
      max-width: 96px;
      top: 20%;
      left: auto;
      right: 8%;
      opacity: 0.62;
    }

    /* 24 Aug 2026 (mobile queue): shrink book covers so ~3 fit across a
       375px viewport instead of ~2. */
    .book-item {
      width: 88px;
    }
    .books-track {
      gap: 16px;
      padding-left: 12px;
      padding-right: 12px;
    }
    .book-title {
      font-size: 12px;
    }
    .book-author {
      font-size: 10.5px;
    }
  }
</style>
