---
/**
 * Work — selected AI project cards, same three projects as the pixel site's
 * "AI Projects" section, pulled from src/content/projects/*.md (real copy,
 * no lorem ipsum).
 */
import { getCollection } from 'astro:content';

const AI_PROJECTS = ['daily-cactus', 'youtube-year', 'second-brain'];
const projects = (await getCollection('projects'))
  .filter((p) => AI_PROJECTS.includes(p.id))
  .sort((a, b) => a.data.order - b.data.order);
---

<section
  id="work"
  class="paper-work"
  data-lab-id="work"
  data-lab-kind="flow"
  data-lab-label="Work section"
  data-lab-group="Work"
  data-lab-props="paddingTop,paddingBottom,background,maxWidth"
>
  <div class="work-inner">
    <h2
      class="work-heading"
      data-lab-id="work.heading"
      data-lab-kind="flow"
      data-lab-label="Work heading"
      data-lab-group="Work"
      data-lab-props="fontSize,letterSpacing,color,align,marginBottom,font"
    >
      AI Projects
    </h2>

    <div class="work-grid" data-lab-id="work.grid" data-lab-kind="flow" data-lab-label="Project list" data-lab-group="Work" data-lab-props="gap,maxWidth">
      {
        projects.map((project) => (
          <div
            class="work-card"
            data-lab-id={`work.card.${project.id}`}
            data-lab-kind="flow"
            data-lab-label={`Project — ${project.data.title}`}
            data-lab-group="Work"
            data-lab-props="fontSize,color,marginTop,marginBottom,maxWidth,font"
          >
            <span class="work-emoji" aria-hidden="true">{project.data.emoji}</span>
            <h3 class="work-title">{project.data.title}</h3>
            <p class="work-summary">{project.data.summary}</p>
            <ul class="work-tags">
              {project.data.tags.map((t: string) => (
                <li class="work-tag">{t}</li>
              ))}
            </ul>
            <span class="work-status">{project.data.status}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .paper-work {
    border-bottom: 1px solid var(--rule);
    padding-block: 160px;
  }

  .work-inner {
    max-width: 1180px;
    margin-inline: auto;
    padding-inline: 24px;
  }

  .work-heading {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(44px, 6vw, 72px);
    letter-spacing: -0.03em;
    line-height: 1.05;
    text-transform: lowercase;
    color: var(--ink);
    text-shadow: var(--letterpress-onlight);
    mix-blend-mode: multiply;
    margin: 0 0 80px;
  }

  .work-heading::first-letter {
    text-transform: uppercase;
  }

  /* A quiet stacked list, not a grid of cards — each project is a rule-
     separated block with room to breathe instead of a boxed tile. */
  .work-grid {
    display: flex;
    flex-direction: column;
    max-width: 640px;
  }

  .work-card {
    position: relative;
    padding-block: 40px;
    border-top: 1px solid var(--paper-line);
  }

  .work-card:first-child {
    border-top: none;
    padding-top: 0;
  }

  .work-emoji {
    font-size: 22px;
    display: block;
    margin-bottom: 12px;
  }

  .work-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 26px;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin: 0 0 12px;
  }

  .work-summary {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-soft);
    margin: 0 0 16px;
  }

  .work-tags {
    list-style: none;
    margin: 0 0 12px;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .work-tag {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .work-tag::before {
    content: '· ';
  }

  .work-tag:first-child::before {
    content: '';
  }

  .work-status {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
  }

  @media (max-width: 767px) {
    .paper-work {
      padding-block: 100px;
    }
  }
</style>
