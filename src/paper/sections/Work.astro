---
/**
 * Work — selected AI project cards, same three projects as the pixel site's
 * "AI projects" section, pulled from src/content/projects/*.md (real copy,
 * no lorem ipsum).
 */
import { getCollection } from 'astro:content';

const AI_PROJECTS = ['daily-cactus', 'youtube-year', 'second-brain'];
const projects = (await getCollection('projects'))
  .filter((p) => AI_PROJECTS.includes(p.id))
  .sort((a, b) => a.data.order - b.data.order);

// 20 Aug 2026 (queue r2): tiles link out to their project pages.
const base = import.meta.env.BASE_URL;
const baseSlash = base.endsWith('/') ? base : base + '/';
---

<section
  id="work"
  class="paper-work"
  data-lab-id="work"
  data-lab-kind="flow"
  data-lab-label="Work section"
  data-lab-group="Work"
  data-lab-props="paddingTop,paddingBottom,background,maxWidth"
>
  {/* 20 Aug 2026 (queue r3): neuralnet decor, top-right, behind the content. */}
  <img
    src={`${baseSlash}paper/decor/neuralnet.png`}
    alt=""
    aria-hidden="true"
    class="work-decor-neuralnet"
  />

  <div class="work-inner">
    <h2
      class="work-heading"
      data-lab-id="work.heading"
      data-lab-kind="flow"
      data-lab-label="Work heading"
      data-lab-group="Work"
      data-lab-props="fontSize,letterSpacing,color,align,marginBottom,font"
    >
      AI Projects
    </h2>

    <div class="work-grid" data-lab-id="work.grid" data-lab-kind="flow" data-lab-label="Project list" data-lab-group="Work" data-lab-props="gap,maxWidth">
      {
        projects.map((project) => (
          <a
            class="work-tile"
            href={`${baseSlash}work/${project.id}`}
            data-lab-id={`work.card.${project.id}`}
            data-lab-kind="flow"
            data-lab-label={`Project | ${project.data.title}`}
            data-lab-group="Work"
            data-lab-props="fontSize,color,marginTop,marginBottom,maxWidth,font"
          >
            <h3 class="work-tile-title">{project.data.title}</h3>
            {project.data.bullets ? (
              <ul class="work-tile-bullets">
                {project.data.bullets.map((b: string) => (
                  <li>{b}</li>
                ))}
              </ul>
            ) : (
              <p class="work-tile-summary">{project.data.summary}</p>
            )}

            {/* 20 Aug 2026 (queue r3): project art fills the reserved slot. */}
            <div class="work-tile-image">
              <img
                src={`${baseSlash}paper/objects/${project.id}.webp`}
                alt=""
                aria-hidden="true"
              />
            </div>

            <ul class="work-tile-tags">
              {project.data.tags.map((t: string) => (
                <li class="work-tile-tag">{t}</li>
              ))}
            </ul>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .paper-work {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--rule);
    /* 20 Aug 2026 (queue r10): standard 80px top space (line → heading), same
       as every other section. */
    padding-block: 80px 96px;
  }

  /* 20 Aug 2026 (queue r3): neuralnet decor, top-right, subtle and behind the
     content. Section above is position:relative + overflow:hidden so this
     can't spill past the section edges. */
  /* 20 Aug 2026 (queue r6): +25% bigger, pushed up + right to almost touch the
     top-right boundary (still fully inside — section clips overflow). */
  .work-decor-neuralnet {
    position: absolute;
    top: 2px;
    right: 2px;
    z-index: 0;
    width: min(37vw, 550px);
    height: auto;
    opacity: 0.4;
    pointer-events: none;
  }

  .work-inner {
    position: relative;
    z-index: 1;
    max-width: 1180px;
    margin-inline: auto;
    padding-inline: 24px;
  }

  .work-heading {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(44px, 6vw, 72px);
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: var(--ink);
    text-shadow: var(--letterpress-onlight);
    mix-blend-mode: multiply;
    margin: 0 0 40px;
  }

  /* 20 Aug 2026 (queue): three project tiles side by side. Each tile is a
     sheet of the terracotta hero paper; heading + one-line summary sit on it
     in white, a reserved image slot fills the middle, tags close it out on a
     single line at the bottom. */
  /* 20 Aug 2026 (queue r2): smaller tiles, spread further apart, capped and
     centred so the grid doesn't stretch edge to edge. */
  /* 20 Aug 2026 (queue r3): wider tiles, more air between them, room for tape
     + 2 bullets + image. */
  .work-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 64px;
    max-width: 1120px;
    margin-inline: auto;
  }

  .work-tile {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 400px;
    padding: 26px 24px;
    border-radius: 4px;
    /* 20 Aug 2026 (queue r3): visible (not hidden) so the top tape strip can
       overhang the tile's top edge; the grain ::after below carries its own
       border-radius so corners still read as rounded. */
    overflow: visible;
    color: var(--paper-hero-ink);
    text-decoration: none;
    background-color: var(--paper-terracotta-tint);
    background-image: var(--paper-terracotta-bg);
    background-size: cover;
    background-position: center;
    /* Paper-lift shadow, light from the top-left, same language as the photos. */
    box-shadow:
      1px 2px 0 rgba(74, 53, 39, 0.18),
      6px 10px 22px rgba(28, 20, 12, 0.22);
  }

  /* Grain over the terracotta so it reads as stock, not a flat swatch. Carries
     its own border-radius now that .work-tile is overflow:visible (queue r3). */
  .work-tile::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 4px;
    overflow: hidden;
    pointer-events: none;
    opacity: var(--grain-hero);
    background-image: var(--grain-texture);
    background-size: var(--grain-size) var(--grain-size);
    mix-blend-mode: soft-light;
  }

  .work-tile > * {
    position: relative;
    z-index: 1;
  }

  /* 20 Aug 2026 (queue r3): one piece of tape at the top-centre of each tile,
     overhanging the top edge. */

  .work-tile-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(26px, 2.4vw, 34px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--paper-hero-ink);
    text-shadow: var(--letterpress-ondark);
    margin: 0 0 12px;
  }

  /* 20 Aug 2026 (queue r2): full summary now, wraps instead of clipping to
     one line. */
  .work-tile-summary {
    font-family: var(--font-body);
    font-size: 14.5px;
    line-height: 1.4;
    color: rgba(244, 239, 224, 0.82);
    margin: 0 0 20px;
  }

  /* 20 Aug 2026 (queue r3): two bullets in place of the one-line summary.
     White text on the terracotta tile, small and readable. */
  .work-tile-bullets {
    list-style: none;
    margin: 0 0 20px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .work-tile-bullets li {
    position: relative;
    padding-left: 14px;
    font-family: var(--font-body);
    font-size: 13.5px;
    line-height: 1.5;
    color: rgba(244, 239, 224, 0.88);
  }

  .work-tile-bullets li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: rgba(244, 239, 224, 0.6);
  }

  /* 20 Aug 2026 (queue r4): fixed 3:2 slot (matches the source art) so all
     three project images crop identically and read as one consistent set. */
  .work-tile-image {
    flex: none;
    width: 100%;
    aspect-ratio: 3 / 2;
    margin-bottom: 20px;
    border-radius: 3px;
    overflow: hidden;
  }

  .work-tile-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* Pinned to the bottom so the tags line up across tiles of differing height. */
  .work-tile-tags {
    list-style: none;
    margin: auto 0 0;
    padding: 0;
    display: flex;
    gap: 12px;
    overflow: hidden;
    white-space: nowrap;
  }

  .work-tile-tag {
    flex: none;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(244, 239, 224, 0.72);
  }

  .work-tile-tag::before {
    content: '· ';
  }

  .work-tile-tag:first-child::before {
    content: '';
  }

  @media (max-width: 860px) {
    .work-grid {
      grid-template-columns: 1fr;
      max-width: 460px;
    }
    .work-tile {
      min-height: 420px;
    }
  }

  /* 20 Aug 2026 (mobile): trimmed the desktop-sized 100px padding, and pulled
     the neuralnet decor down so it stays a subtle corner accent instead of
     dominating a narrow tile column (it was already small in vw terms, but
     confirming an explicit mobile size here rather than relying on vw math). */
  @media (max-width: 767px) {
    .paper-work {
      padding-block: 64px 72px;
    }
    .work-inner {
      padding-inline: 20px;
    }
    .work-decor-neuralnet {
      width: min(45vw, 200px);
      opacity: 0.3;
    }
    .work-tile {
      padding: 22px 20px;
      min-height: 0;
    }
  }

  /* 20 Aug 2026 (mobile): 375/320px. */
  @media (max-width: 480px) {
    .paper-work {
      padding-block: 48px 56px;
    }
    .work-heading {
      margin-bottom: 28px;
    }
    .work-decor-neuralnet {
      width: min(40vw, 160px);
    }
  }
</style>
