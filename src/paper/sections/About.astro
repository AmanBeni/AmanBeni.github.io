---
/**
 * About — cream section, a white floating PaperCard of body copy on the
 * left, the papercraft desk photo sitting on graph paper on the right.
 */
import PaperPhoto from '../components/PaperPhoto.astro';

const base = import.meta.env.BASE_URL;
const baseSlash = base.endsWith('/') ? base : base + '/';
---

<section
  id="about"
  class="paper-about"
  data-lab-id="about"
  data-lab-kind="flow"
  data-lab-label="About section"
  data-lab-group="About"
  data-lab-props="paddingTop,paddingBottom,background,maxWidth"
>
  <div class="about-inner">
    <h2
      class="about-heading"
      data-lab-id="about.eyebrow"
      data-lab-kind="flow"
      data-lab-label="About heading"
      data-lab-group="About"
      data-lab-props="fontSize,letterSpacing,color,marginBottom,font"
    >
      About
    </h2>

    <div class="about-row">
      <div class="about-copy">
        <div
          data-lab-id="about.paragraph1"
          data-lab-kind="flow"
          data-lab-label="About paragraph 1"
          data-lab-group="About"
          data-lab-props="fontSize,lineHeight,color,marginBottom,font,maxWidth"
        >
          <p>
            I am Aman. Business strategy professional with 3+ years of experience across a $6B
            global transformation program spanning India, APAC, EMEA, and NAM. Worked closely
            with senior leadership on strategic decisions, pricing optimisation, and AI-led
            operations improvements across global business units.
          </p>
        </div>
        <div
          data-lab-id="about.paragraph2"
          data-lab-kind="flow"
          data-lab-label="About paragraph 2"
          data-lab-group="About"
          data-lab-props="fontSize,lineHeight,color,marginTop,marginBottom,font,maxWidth"
        >
          <p>
            Took a career break in January 2026 to focus on certain important personal
            responsibilities and introspect on the career journey ahead. Worked with an NGO to
            structure their database and automate M&amp;E, alongside learning AI system design
            from first principles and building a few projects and agents.
          </p>
        </div>
        <div
          data-lab-id="about.paragraph3"
          data-lab-kind="flow"
          data-lab-label="About paragraph 3"
          data-lab-group="About"
          data-lab-props="fontSize,lineHeight,color,marginTop,font,maxWidth"
        >
          <p>
            Now looking for AI-focused strategic roles where innovation is used to do good for
            our society and the planet.
          </p>
        </div>
      </div>

      <div class="about-photo-stage" data-lab-canvas>
        <img
          class="about-litho"
          src={`${baseSlash}paper/decor/litho-grid.png`}
          alt=""
          aria-hidden="true"
        />
        <div
          class="about-desk"
          data-lab-id="about.desk-photo"
          data-lab-kind="free"
          data-lab-label="Desk object photo"
          data-lab-group="About"
          data-lab-props="x,y,rotate,scale,z,opacity,shadow"
          data-lab-asset="objects"
        >
          {/* 20 Aug 2026 (queue r2): swapped to the new about-desk render; tape + shadow follow automatically via PaperPhoto. */}
          <PaperPhoto
            src={`${baseSlash}paper/objects/about-desk.webp`}
            alt="Papercraft desk, lamp and books, a small still-life"
            width="100%"
            size="large"
            seed="about-desk"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .paper-about {
    /* 27 Aug 2026: dividing hairline removed — About and Education (Career &
       Education) now merge into one visual section, "About". Education kept
       its own <section> in the DOM; only the visible seam is gone. */
    /* 20 Aug 2026 (queue r10): standard 80px top space (line → heading). */
    /* 27 Aug 2026: bottom trimmed 96px → 40px — was the "end of section"
       gap before the rule that's now gone; the Education content picks up
       close behind instead of leaving a big orphaned gap. */
    padding-block: 80px 40px;
    position: relative;
    /* 20 Aug 2026 (queue r2): hard clip so the enlarged/repositioned litho
       grid below can never spill past the section frame. */
    overflow: hidden;
  }

  .about-inner {
    max-width: 1180px;
    margin-inline: auto;
    padding-inline: 24px;
  }

  /* 19 Aug 2026: was a small mono eyebrow label; restored as a proper
     section heading matching Education/Work/Skills/Beyond/Contact. */
  .about-heading {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(44px, 6vw, 72px);
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: var(--ink);
    text-shadow: var(--letterpress-onlight);
    mix-blend-mode: multiply;
    margin: 0 0 40px;
  }

  .about-row {
    display: grid;
    grid-template-columns: 1fr 0.9fr;
    gap: 72px;
    align-items: center;
  }

  .about-copy {
    max-width: 52ch;
  }

  .about-copy :global(p) {
    margin: 0;
    font-family: var(--font-body);
    font-size: 18px;
    line-height: 1.75;
    color: var(--ink);
  }

  .about-copy :global(div + div) {
    margin-top: 24px;
  }

  .about-photo-stage {
    position: relative;
  }

  /* Engineering grid sitting behind and below the desk photo, peeking out at
     the left and bottom like a backing sheet (Aman's reference). Cream ground
     here, so the grey lines show directly, no blend. */
  .about-litho {
    position: absolute;
    z-index: 0;
    /* 20 Aug 2026 (queue r3): sized up further and moved up + right again
       per Aman's note; .paper-about clips overflow so it stays inside the
       section frame at this larger size. */
    width: 135%;
    left: 10%;
    /* 20 Aug 2026 (queue r4): moved higher per Aman's note; .paper-about
       still clips overflow so this stays inside the section frame. */
    top: -18%;
    opacity: 0.5;
    pointer-events: none;
  }

  .about-desk {
    position: relative;
    z-index: 1;
  }

  .about-desk {
    position: relative;
    /* 19 Aug 2026 (execution round): shifted left within its column
       (change 5). */
    margin-left: -48px;
  }

  .about-desk img {
    display: block;
    width: 100%;
    height: auto;
    /* 19 Aug 2026: white photo-frame border removed (change 2). */
    border: none;
  }

  @media (max-width: 860px) {
    .paper-about {
      padding-block: 100px 40px;
    }
    .about-row {
      grid-template-columns: 1fr;
      gap: 56px;
    }
    .about-copy {
      max-width: none;
    }
    .about-desk {
      margin-left: 0;
    }
  }

  /* 20 Aug 2026 (mobile): comfortable phone padding (was still the 100px
     tablet value), and the enlarged/offset litho grid pulled back in so it
     reads as a backing sheet instead of a near-full-bleed graphic behind the
     stacked photo. Section still clips overflow so this is belt-and-braces. */
  @media (max-width: 767px) {
    .paper-about {
      padding-block: 64px 24px;
    }
    .about-inner {
      padding-inline: 20px;
    }
    .about-litho {
      width: 100%;
      left: 0;
      top: -6%;
      opacity: 0.4;
    }
    /* 25 Aug 2026 (mobile queue): on phones the desk photo stacked full-column
       and hugged the right edge (there's no desktop-style right column here).
       Shrink it and centre it, nudged slightly left, so it reads as a centred
       object. The litho backing stays full-width so it still peeks behind. */
    .about-photo-stage,
    .about-desk {
      text-align: center;
    }
    .about-desk :global(.paper-photo) {
      width: 80% !important;
      margin: 22px 0 0 !important;
      position: relative;
      left: -12px;
    }
  }

  /* 20 Aug 2026 (mobile): tighter still at 375/320px. */
  @media (max-width: 480px) {
    .paper-about {
      padding-block: 48px 16px;
    }
    .about-heading {
      margin-bottom: 28px;
    }
    .about-row {
      gap: 40px;
    }
    .about-litho {
      top: -4%;
    }
  }
</style>
