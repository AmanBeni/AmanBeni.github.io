---
/** Contact — closing section, dark kraft card with the two real contact links. */
---

<section
  id="contact"
  class="paper-contact"
  data-lab-id="contact"
  data-lab-kind="flow"
  data-lab-label="Contact section"
  data-lab-group="Contact"
  data-lab-props="paddingTop,paddingBottom,background,maxWidth"
>
  <div class="contact-inner">
    <h2
      class="contact-heading"
      data-lab-id="contact.heading"
      data-lab-kind="flow"
      data-lab-label="Contact heading"
      data-lab-group="Contact"
      data-lab-props="fontSize,letterSpacing,color,align,marginBottom,font"
    >
      Contact
    </h2>

    <div class="contact-lines">
      <p
        class="contact-line"
        data-lab-id="contact.email"
        data-lab-kind="flow"
        data-lab-label="Email line"
        data-lab-group="Contact"
        data-lab-props="fontSize,color,marginBottom,font"
      >
        <span class="contact-label">Email</span>
        <a href="mailto:beniwalaman2@gmail.com">beniwalaman2@gmail.com</a>
      </p>
      <p
        class="contact-line"
        data-lab-id="contact.linkedin"
        data-lab-kind="flow"
        data-lab-label="LinkedIn line"
        data-lab-group="Contact"
        data-lab-props="fontSize,color,marginTop,font"
      >
        <span class="contact-label">LinkedIn</span>
        <a href="https://www.linkedin.com/in/aman-beniwal/" target="_blank" rel="noopener noreferrer">
          linkedin.com/in/aman-beniwal
        </a>
      </p>
    </div>
  </div>
</section>

<style>
  .paper-contact {
    /* No background of its own. The single page background runs through,
       and the rule above it is what marks the section. */
    padding-block: 180px;
    color: var(--ink);
    position: relative;
  }

  .paper-contact::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    /* Light ground now, so the grain multiplies down into the paper rather
       than soft-lighting up off a dark one. Lighter touch too, since the
       page background already carries its own texture underneath. */
    opacity: calc(var(--grain) * 0.35);
    background-image: var(--grain-texture);
    background-size: var(--grain-size) var(--grain-size);
    mix-blend-mode: multiply;
  }

  .contact-inner {
    position: relative;
    z-index: 1;
    max-width: 1180px;
    margin-inline: auto;
    padding-inline: 24px;
  }

  .contact-heading {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(48px, 7vw, 88px);
    letter-spacing: -0.03em;
    line-height: 1.05;
    text-transform: lowercase;
    color: var(--ink);
    text-shadow: var(--letterpress-ondark);
    margin: 0 0 64px;
  }

  .contact-lines {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .contact-line {
    font-family: var(--font-body);
    font-size: 16px;
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 12px;
  }

  .contact-label {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(244, 239, 224, 0.6);
  }

  .contact-line a {
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid rgba(244, 239, 224, 0.5);
  }

  .contact-line a:hover {
    border-bottom-color: var(--ink);
  }
</style>
