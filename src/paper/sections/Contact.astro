---
/** Contact — closing section, dark kraft card with the two real contact links. */
---

<section
  id="contact"
  class="paper-contact"
  data-lab-id="contact"
  data-lab-kind="flow"
  data-lab-label="Contact section"
  data-lab-group="Contact"
  data-lab-props="paddingTop,paddingBottom,background,maxWidth"
>
  <div class="contact-inner">
    <h2
      class="contact-heading"
      data-lab-id="contact.heading"
      data-lab-kind="flow"
      data-lab-label="Contact heading"
      data-lab-group="Contact"
      data-lab-props="fontSize,letterSpacing,color,align,marginBottom,font"
    >
      Contact
    </h2>

    <div class="contact-lines">
      <p
        class="contact-line"
        data-lab-id="contact.email"
        data-lab-kind="flow"
        data-lab-label="Email line"
        data-lab-group="Contact"
        data-lab-props="fontSize,color,marginBottom,font"
      >
        <span class="contact-label">Email</span>
        <a href="mailto:beniwalaman2@gmail.com">beniwalaman2@gmail.com</a>
      </p>
      <p
        class="contact-line"
        data-lab-id="contact.linkedin"
        data-lab-kind="flow"
        data-lab-label="LinkedIn line"
        data-lab-group="Contact"
        data-lab-props="fontSize,color,marginTop,font"
      >
        <span class="contact-label">LinkedIn</span>
        <a href="https://www.linkedin.com/in/aman-beniwal/" target="_blank" rel="noopener noreferrer">
          linkedin.com/in/aman-beniwal
        </a>
      </p>
    </div>
  </div>
</section>

<style>
  .paper-contact {
    /* 19 Aug 2026: restored the green textured ground Hero has, so Contact
       bookends the page (was accidentally left transparent). */
    background-color: var(--paper-hero-tint);
    background-image: var(--paper-hero-bg);
    background-size: cover;
    background-position: center;
    padding-block: 110px;
    color: var(--paper-hero-ink);
    position: relative;
  }

  .paper-contact::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    /* Dark ground, same as Hero — soft-light instead of multiply. */
    opacity: calc(var(--grain) * 0.9);
    background-image: var(--grain-texture);
    background-size: var(--grain-size) var(--grain-size);
    mix-blend-mode: soft-light;
  }

  .contact-inner {
    position: relative;
    z-index: 1;
    max-width: 1180px;
    margin-inline: auto;
    padding-inline: 24px;
  }

  .contact-heading {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(48px, 7vw, 88px);
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: var(--paper-hero-ink);
    text-shadow: var(--letterpress-ondark);
    margin: 0 0 40px;
  }

  .contact-lines {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .contact-line {
    font-family: var(--font-body);
    font-size: 18px;
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 12px;
  }

  .contact-label {
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(244, 239, 224, 0.6);
  }

  .contact-line a {
    color: var(--paper-hero-ink);
    text-decoration: none;
    border-bottom: 1px solid rgba(244, 239, 224, 0.5);
  }

  .contact-line a:hover {
    border-bottom-color: var(--paper-hero-ink);
  }

  /* 20 Aug 2026 (mobile): this section had no responsive rules at all — the
     fixed 110px padding-block was desktop-sized, and the label+link flex row
     had no wrap, so a long LinkedIn URL next to its mono label could overflow
     a 375/320px viewport instead of dropping to a second line. */
  @media (max-width: 767px) {
    .paper-contact {
      padding-block: 72px;
    }
    .contact-inner {
      padding-inline: 20px;
    }
    .contact-heading {
      margin-bottom: 28px;
    }
    .contact-line {
      flex-wrap: wrap;
      gap: 4px 12px;
    }
  }

  /* 20 Aug 2026 (mobile): 375/320px. */
  @media (max-width: 480px) {
    .paper-contact {
      padding-block: 56px;
    }
    .contact-line {
      font-size: 16px;
    }
  }
</style>
