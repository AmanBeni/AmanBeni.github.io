---
/**
 * Education — cream-alt section, big Didone serif "Career & Education"
 * heading, two columns (Experience / Education + Volunteering) rendered as
 * simple paper-stamped entries. Content copied from src/pages/index.astro
 * (same source of truth, duplicated here since Track A doesn't touch that
 * file) — keep the two in sync if Aman edits his CV.
 */

const base = import.meta.env.BASE_URL;
const baseSlash = base.endsWith('/') ? base : base + '/';
const logoBase = baseSlash + 'logos/';

// 20 Aug 2026 (queue r2): short hyphen inside date ranges, "|" between a
// title and its qualifier (dash cleanup, per queue).
const experience = [
  {
    org: 'Infosys',
    logo: 'infosys.svg',
    roles: [
      { title: 'Analyst | Corporate Strategy', period: 'Dec 2023 - Dec 2025' },
      { title: 'Associate Functional Consultant', period: 'Jun 2022 - Nov 2023' },
    ],
  },
  {
    org: 'appengine.ai',
    logo: 'appengine.png',
    roles: [{ title: 'Associate Intern', period: 'Jun - Aug 2021' }],
  },
  {
    org: 'Plutomen Technologies',
    logo: 'plutomen.png',
    roles: [{ title: 'Summer Intern', period: 'Apr - Jul 2021' }],
  },
  {
    org: 'Lemon Tree Hotels',
    logo: 'lemontree.png',
    roles: [{ title: 'Sales & Marketing Intern', period: 'May 2019' }],
  },
];

const education = [
  {
    org: 'Institute of Management, Nirma University',
    logo: 'nirma.png',
    roles: [
      {
        title: 'MBA | Business Administration',
        period: '2020 - 2022',
        notes: ['Treasurer & Member Secretary, Placement Cell'],
      },
      {
        title: 'BBA | Business Administration',
        period: '2017 - 2020',
        notes: ['Member, Cultural Committee', 'Lead, Photography Committee'],
      },
    ],
  },
];

const volunteering = [
  { org: 'Asaadharan NGO', roles: [{ title: 'Volunteer', period: 'Apr - Jun 2026' }] },
  { org: 'Naya Sawera NGO', roles: [{ title: 'Volunteer', period: 'May 2018' }] },
];
---

<section
  id="education"
  class="paper-education"
  data-lab-id="education"
  data-lab-kind="flow"
  data-lab-label="Career & Education (merged into About)"
  data-lab-group="Education"
  data-lab-props="paddingTop,paddingBottom,background,maxWidth"
>
  <div class="education-inner">
    {/* 27 Aug 2026: "Career & Education" heading removed — this section now
        merges visually into About (no heading, no dividing rule; see the
        border-bottom removed from .paper-about and the padding-top trimmed
        below). Kept as its own <section id="education"> in the DOM (anchors,
        component boundary) — only the visible seam is gone. */}
    <div class="education-grid">
      <div class="education-col">
        <h3
          class="education-colhead"
          data-lab-id="education.experience-heading"
          data-lab-kind="flow"
          data-lab-label="Experience column heading"
          data-lab-group="Education"
          data-lab-props="fontSize,letterSpacing,color,marginBottom,font"
        >
          Experience
        </h3>
        {
          experience.map((item, i) => (
            <div
              class="cv-entry"
              data-lab-id={`education.experience.${i}`}
              data-lab-kind="flow"
              data-lab-label={`Experience | ${item.org}`}
              data-lab-group="Education"
              data-lab-props="fontSize,color,marginTop,marginBottom,font"
            >
              <div class="cv-logo">
                <img src={`${logoBase}${item.logo}`} alt={`${item.org} logo`} loading="lazy" />
              </div>
              <div class="cv-text">
                <p class="cv-org">{item.org}</p>
                {item.roles.map((r) => (
                  <p class="cv-role">
                    {r.title} <span class="cv-period">({r.period})</span>
                  </p>
                ))}
              </div>
            </div>
          ))
        }
      </div>

      <div class="education-col">
        <h3
          class="education-colhead"
          data-lab-id="education.education-heading"
          data-lab-kind="flow"
          data-lab-label="Education column heading"
          data-lab-group="Education"
          data-lab-props="fontSize,letterSpacing,color,marginBottom,font"
        >
          Education
        </h3>
        {
          education.map((item, i) => (
            <div
              class="cv-entry"
              data-lab-id={`education.education.${i}`}
              data-lab-kind="flow"
              data-lab-label={`Education | ${item.org}`}
              data-lab-group="Education"
              data-lab-props="fontSize,color,marginTop,marginBottom,font"
            >
              <div class="cv-logo">
                <img src={`${logoBase}${item.logo}`} alt={`${item.org} logo`} loading="lazy" />
              </div>
              <div class="cv-text">
                <p class="cv-org">{item.org}</p>
                {item.roles.map((r) => (
                  <>
                    <p class="cv-role">
                      {r.title} <span class="cv-period">({r.period})</span>
                    </p>
                    {r.notes?.map((n) => <p class="cv-note">{n}</p>)}
                  </>
                ))}
              </div>
            </div>
          ))
        }

        <h3
          class="education-colhead education-colhead-alt"
          data-lab-id="education.volunteering-heading"
          data-lab-kind="flow"
          data-lab-label="Volunteering column heading"
          data-lab-group="Education"
          data-lab-props="fontSize,letterSpacing,color,marginTop,marginBottom,font"
        >
          Volunteering
        </h3>
        {
          volunteering.map((item, i) => (
            <div
              class="cv-entry cv-entry-plain"
              data-lab-id={`education.volunteering.${i}`}
              data-lab-kind="flow"
              data-lab-label={`Volunteering | ${item.org}`}
              data-lab-group="Education"
              data-lab-props="fontSize,color,marginTop,marginBottom,font"
            >
              <div class="cv-text">
                <p class="cv-org">{item.org}</p>
                {item.roles.map((r) => (
                  <p class="cv-role">
                    {r.title} <span class="cv-period">({r.period})</span>
                  </p>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>

  </div>
</section>

<style>
  .paper-education {
    border-bottom: 1px solid var(--rule);
    /* 27 Aug 2026: top space trimmed 80px → 40px when the heading/rule came
       out — read as too close (Aman). Bumped back up to 56px; combined with
       About's bottom padding this is the gap between About's last paragraph
       and the Experience heading. */
    padding-block: 56px 96px;
    position: relative;
  }

  .education-inner {
    max-width: var(--content-max);
    margin-inline: auto;
    padding-inline: 24px;
    position: relative;
  }


  /* 20 Aug 2026 (queue r6): back to full-width two columns (r5's narrowing
     cramped them). The photo just tucks into the bottom-right corner. */
  .education-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
  }

  /* 20 Aug 2026 (queue r2): 12.5px read as body text — bumped to 15px. */
  .education-colhead {
    font-family: var(--font-mono);
    font-size: 15px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin: 0 0 24px;
    border-bottom: 1px solid var(--paper-line);
    padding-bottom: 12px;
  }

  .education-colhead-alt {
    margin-top: 40px;
  }

  .cv-entry {
    display: flex;
    gap: 14px;
    margin-top: 22px;
  }

  .cv-entry:first-of-type {
    margin-top: 0;
  }

  .cv-entry-plain {
    padding-left: 0;
  }

  .cv-logo {
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 2px;
    background: var(--paper-card);
    border: 1px solid var(--paper-line);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cv-logo img {
    max-width: 26px;
    max-height: 26px;
    object-fit: contain;
  }

  .cv-org {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 18px;
    color: var(--ink);
    margin: 0 0 4px;
  }

  /* 20 Aug 2026 (queue r2): role is now the dominant colour, period is the
     soft/bracketed one — this was backwards before. */
  .cv-role {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 15px;
    color: var(--ink);
    margin: 0;
  }

  .cv-period {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--ink-soft);
  }

  /* 20 Aug 2026 (queue r3): indented so committee notes read as sub-items
     under their role (item 41) — no bullet/marker, just the indent. */
  .cv-note {
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--ink-soft);
    margin: 2px 0 0;
    margin-left: 20px;
  }

  /* 20 Aug 2026 (mobile): confirmed single-column CV grid holds at 767 and
     narrower; just trimmed the desktop-sized 100px padding down to something
     comfortable on a phone. */
  @media (max-width: 767px) {
    .paper-education {
      padding-block: 32px 72px;
    }
    .education-inner {
      padding-inline: 20px;
    }
    .education-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }

  /* 20 Aug 2026 (mobile): 375/320px — logo+text row stays comfortable, just
     less top/bottom air. */
  @media (max-width: 480px) {
    .paper-education {
      padding-block: 20px 56px;
    }
    .cv-entry {
      gap: 12px;
    }
  }
</style>
