---
/**
 * Education — cream-alt section, big Didone serif "Career & Education"
 * heading, two columns (Experience / Education + Volunteering) rendered as
 * simple paper-stamped entries. Content copied from src/pages/index.astro
 * (same source of truth, duplicated here since Track A doesn't touch that
 * file) — keep the two in sync if Aman edits his CV.
 */
const base = import.meta.env.BASE_URL;
const baseSlash = base.endsWith('/') ? base : base + '/';
const logoBase = baseSlash + 'logos/';

const experience = [
  {
    org: 'Infosys',
    logo: 'infosys.svg',
    roles: [
      { title: 'Analyst — Corporate Strategy', period: 'Dec 2023 — Dec 2025' },
      { title: 'Associate Functional Consultant', period: 'Jun 2022 — Nov 2023' },
    ],
  },
  {
    org: 'appengine.ai',
    logo: 'appengine.png',
    roles: [{ title: 'Associate Intern', period: 'Jun — Aug 2021' }],
  },
  {
    org: 'Plutomen Technologies',
    logo: 'plutomen.png',
    roles: [{ title: 'Summer Intern', period: 'Apr — Jul 2021' }],
  },
  {
    org: 'Lemon Tree Hotels',
    logo: 'lemontree.png',
    roles: [{ title: 'Sales & Marketing Intern', period: 'May 2019' }],
  },
];

const education = [
  {
    org: 'Institute of Management, Nirma University',
    logo: 'nirma.png',
    roles: [
      {
        title: 'MBA — Business Administration',
        period: '2020 — 2022',
        notes: ['Treasurer & Member Secretary, Placement Cell'],
      },
      {
        title: 'BBA — Business Administration',
        period: '2017 — 2020',
        notes: ['Member, Cultural Committee', 'Lead, Photography Committee'],
      },
    ],
  },
];

const volunteering = [
  { org: 'Asaadharan NGO', roles: [{ title: 'Volunteer', period: 'Apr — Jun 2026' }] },
  { org: 'Naya Sawera NGO', roles: [{ title: 'Volunteer', period: 'May 2018' }] },
];
---

<section
  id="education"
  class="paper-education"
  data-lab-id="education"
  data-lab-kind="flow"
  data-lab-label="Career & Education section"
  data-lab-group="Education"
  data-lab-props="paddingTop,paddingBottom,background,maxWidth"
>
  <div class="education-inner">
    <h2
      class="education-heading"
      data-lab-id="education.heading"
      data-lab-kind="flow"
      data-lab-label="Education heading"
      data-lab-group="Education"
      data-lab-props="fontSize,letterSpacing,lineHeight,color,align,marginBottom,font"
    >
      Career &amp; Education
    </h2>

    <div class="education-grid">
      <div class="education-col">
        <h3
          class="education-colhead"
          data-lab-id="education.experience-heading"
          data-lab-kind="flow"
          data-lab-label="Experience column heading"
          data-lab-group="Education"
          data-lab-props="fontSize,letterSpacing,color,marginBottom,font"
        >
          Experience
        </h3>
        {
          experience.map((item, i) => (
            <div
              class="cv-entry"
              data-lab-id={`education.experience.${i}`}
              data-lab-kind="flow"
              data-lab-label={`Experience — ${item.org}`}
              data-lab-group="Education"
              data-lab-props="fontSize,color,marginTop,marginBottom,font"
            >
              <div class="cv-logo">
                <img src={`${logoBase}${item.logo}`} alt={`${item.org} logo`} loading="lazy" />
              </div>
              <div class="cv-text">
                <p class="cv-org">{item.org}</p>
                {item.roles.map((r) => (
                  <p class="cv-role">
                    {r.title} <span class="cv-period">{r.period}</span>
                  </p>
                ))}
              </div>
            </div>
          ))
        }
      </div>

      <div class="education-col">
        <h3
          class="education-colhead"
          data-lab-id="education.education-heading"
          data-lab-kind="flow"
          data-lab-label="Education column heading"
          data-lab-group="Education"
          data-lab-props="fontSize,letterSpacing,color,marginBottom,font"
        >
          Education
        </h3>
        {
          education.map((item, i) => (
            <div
              class="cv-entry"
              data-lab-id={`education.education.${i}`}
              data-lab-kind="flow"
              data-lab-label={`Education — ${item.org}`}
              data-lab-group="Education"
              data-lab-props="fontSize,color,marginTop,marginBottom,font"
            >
              <div class="cv-logo">
                <img src={`${logoBase}${item.logo}`} alt={`${item.org} logo`} loading="lazy" />
              </div>
              <div class="cv-text">
                <p class="cv-org">{item.org}</p>
                {item.roles.map((r) => (
                  <>
                    <p class="cv-role">
                      {r.title} <span class="cv-period">{r.period}</span>
                    </p>
                    {r.notes?.map((n) => <p class="cv-note">{n}</p>)}
                  </>
                ))}
              </div>
            </div>
          ))
        }

        <h3
          class="education-colhead education-colhead-alt"
          data-lab-id="education.volunteering-heading"
          data-lab-kind="flow"
          data-lab-label="Volunteering column heading"
          data-lab-group="Education"
          data-lab-props="fontSize,letterSpacing,color,marginTop,marginBottom,font"
        >
          Volunteering
        </h3>
        {
          volunteering.map((item, i) => (
            <div
              class="cv-entry cv-entry-plain"
              data-lab-id={`education.volunteering.${i}`}
              data-lab-kind="flow"
              data-lab-label={`Volunteering — ${item.org}`}
              data-lab-group="Education"
              data-lab-props="fontSize,color,marginTop,marginBottom,font"
            >
              <div class="cv-text">
                <p class="cv-org">{item.org}</p>
                {item.roles.map((r) => (
                  <p class="cv-role">
                    {r.title} <span class="cv-period">{r.period}</span>
                  </p>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .paper-education {
    border-bottom: 1px solid var(--rule);
    padding-block: 160px;
  }

  .education-inner {
    max-width: 1180px;
    margin-inline: auto;
    padding-inline: 24px;
  }

  .education-heading {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(44px, 6vw, 80px);
    letter-spacing: -0.03em;
    line-height: 1.05;
    text-transform: lowercase;
    color: var(--ink);
    text-shadow: var(--letterpress-onlight);
    mix-blend-mode: multiply;
    margin: 0 0 88px;
  }

  .education-heading::first-letter {
    text-transform: uppercase;
  }

  .education-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
  }

  .education-colhead {
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin: 0 0 24px;
    border-bottom: 1px solid var(--paper-line);
    padding-bottom: 12px;
  }

  .education-colhead-alt {
    margin-top: 40px;
  }

  .cv-entry {
    display: flex;
    gap: 14px;
    margin-top: 22px;
  }

  .cv-entry:first-of-type {
    margin-top: 0;
  }

  .cv-entry-plain {
    padding-left: 0;
  }

  .cv-logo {
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 2px;
    background: var(--paper-card);
    border: 1px solid var(--paper-line);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cv-logo img {
    max-width: 26px;
    max-height: 26px;
    object-fit: contain;
  }

  .cv-org {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 18px;
    color: var(--ink);
    margin: 0 0 4px;
  }

  .cv-role {
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--ink-soft);
    margin: 0;
  }

  .cv-period {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--accent);
  }

  .cv-note {
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--ink-soft);
    margin: 2px 0 0;
  }

  @media (max-width: 767px) {
    .paper-education {
      padding-block: 100px;
    }
    .education-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }
</style>
