---
/**
 * DotGrid.astro — site-wide interactive dot-grid background.
 *
 * position:fixed, full-viewport canvas sitting behind all page content
 * (z-index: -1 on a positioned element always paints beneath normal in-flow
 * content per CSS stacking rules, regardless of DOM order). The canvas
 * itself is left transparent except where dots/lines are drawn, so the
 * page's own `--surface` background (set on <body>) shows through — the
 * effect is only visible through sections/cards that don't paint their own
 * opaque background over it. No hit-testing against page content is done;
 * pointer-events are disabled so it never intercepts clicks.
 *
 * No canvas/animation library — plain 2D canvas + vanilla JS.
 */
---

<canvas id="dot-grid" aria-hidden="true"></canvas>

<style>
  #dot-grid {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: -1;
    pointer-events: none;
    display: block;
  }
</style>

<script>
  (() => {
    const canvas = document.getElementById('dot-grid') as HTMLCanvasElement | null;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const SPACING = 24; // px between dots (~20% denser)
    const DOT_SIZE = 3; // px square (50% bigger, reads as a square not a dot)
    const RADIUS = 85; // px — cursor influence radius (kept close so only nearby dots connect)
    const DOT_COLOR = '26, 26, 26'; // --ink, as an rgb triplet for rgba()
    const BASE_ALPHA = 0.1; // static dot alpha (~10%)
    const HOVER_ALPHA = 0.32; // brightened dot alpha at cursor
    const LINE_ALPHA_MAX = 0.22;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let dpr = Math.max(1, window.devicePixelRatio || 1);
    let width = window.innerWidth;
    let height = window.innerHeight;
    let cols = 0;
    let rows = 0;

    // Cursor state. `active` ramps 0->1 on movement and decays back to 0
    // after the pointer leaves, so lines fade out instead of cutting off.
    let mouseX = -9999;
    let mouseY = -9999;
    let active = 0;
    let rafId: number | null = null;
    let lastMoveAt = 0;

    // Colour sources in DOCUMENT space (px). Lines near a source tint toward its
    // colour (echoing nearby art); everywhere else they stay grey. Positioned
    // relative to the hero so the marigold/flower tints sit under the hero corners.
    let sources: { x: number; y: number; r: number; c: number[] }[] = [];
    function computeSources() {
      const hero = document.querySelector('.hero') as HTMLElement | null;
      const hh = hero ? hero.offsetHeight : window.innerHeight * 0.86;
      sources = [
        { x: width * 0.13, y: hh * 0.98, r: 300, c: [255, 205, 20] }, // marigold yellow (brighter)
        { x: width * 0.5, y: hh * 0.95, r: 300, c: [92, 178, 58] }, // plant green (brighter)
        { x: width * 0.9, y: hh * 0.92, r: 300, c: [212, 74, 138] }, // pink flowers
      ];

      // Green tint under the tree in the About section (colour sampled from the
      // tree's grass). Anchored to the element so it tracks its real position.
      const tree = document.querySelector('.decor-tree') as HTMLElement | null;
      if (tree) {
        const rect = tree.getBoundingClientRect();
        sources.push({
          x: rect.left + rect.width * 0.55,
          y: rect.top + window.scrollY + rect.height * 0.82,
          r: 270,
          c: [150, 188, 98],
        });
      }

      // Light-blue tint near the Beyond Work clouds (colour sampled from the cloud).
      const clouds = document.querySelector('.beyond-clouds') as HTMLElement | null;
      if (clouds) {
        const rect = clouds.getBoundingClientRect();
        sources.push({
          x: width * 0.5,
          y: rect.top + window.scrollY + 90,
          r: 420,
          c: [159, 210, 248],
        });
      }
    }
    function lineColor(vx: number, vy: number, alpha: number): string {
      const dy = vy + window.scrollY; // dot's document-space Y
      let best: number[] | null = null;
      let bestW = 0;
      for (const s of sources) {
        const d = Math.hypot(vx - s.x, dy - s.y);
        if (d < s.r) {
          const w = 1 - d / s.r;
          if (w > bestW) {
            bestW = w;
            best = s.c;
          }
        }
      }
      if (!best) return `rgba(${DOT_COLOR}, ${alpha})`;
      // stronger colour: high colour floor even at the zone edge (so hues read
      // vivid, not muted greyish), and coloured lines noticeably more opaque
      // than the grey ones so they don't wash out against the near-white bg.
      const t = 0.72 + 0.28 * bestW;
      const r = Math.round(26 + (best[0] - 26) * t);
      const g = Math.round(26 + (best[1] - 26) * t);
      const b = Math.round(26 + (best[2] - 26) * t);
      const a = Math.min(0.9, alpha * 3.6);
      return `rgba(${r}, ${g}, ${b}, ${a})`;
    }

    function resize(force?: boolean) {
      const w = window.innerWidth;
      const h = window.innerHeight;
      // Mobile browsers fire `resize` every time the URL bar hides/shows on
      // scroll (height changes, width doesn't). Rebuilding the grid on those
      // events is what made the dots visibly jitter while scrolling. Ignore
      // height-only changes: only rebuild on a real width change (orientation)
      // or when we need MORE height than we've already covered. Height is
      // grow-only so the newly revealed strip (URL bar gone) never shows a gap.
      if (!force && w === width && h <= height) return;
      dpr = Math.max(1, window.devicePixelRatio || 1);
      width = w;
      height = Math.max(height, h);
      canvas!.width = Math.round(width * dpr);
      canvas!.height = Math.round(height * dpr);
      canvas!.style.width = `${width}px`;
      canvas!.style.height = `${height}px`;
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      cols = Math.ceil(width / SPACING) + 1;
      rows = Math.ceil(height / SPACING) + 1;
      computeSources();
      drawStatic();
    }

    function drawStatic() {
      ctx!.clearRect(0, 0, width, height);
      ctx!.fillStyle = `rgba(${DOT_COLOR}, ${BASE_ALPHA})`;
      const h = DOT_SIZE / 2;
      for (let i = 0; i < cols; i++) {
        const x = i * SPACING;
        for (let j = 0; j < rows; j++) {
          const y = j * SPACING;
          ctx!.fillRect(Math.round(x - h), Math.round(y - h), DOT_SIZE, DOT_SIZE);
        }
      }
    }

    // Full interactive frame: static grid + brightened dots/lines near the
    // cursor. Only the local neighborhood of the cursor is scanned (not the
    // whole grid) to keep this cheap.
    function drawFrame() {
      ctx!.clearRect(0, 0, width, height);
      ctx!.fillStyle = `rgba(${DOT_COLOR}, ${BASE_ALPHA})`;
      for (let i = 0; i < cols; i++) {
        const x = i * SPACING;
        for (let j = 0; j < rows; j++) {
          const y = j * SPACING;
          ctx!.fillRect(x - DOT_SIZE / 2, y - DOT_SIZE / 2, DOT_SIZE, DOT_SIZE);
        }
      }

      if (active <= 0.01) return;

      // Cursor's nearest grid node — every path flows toward this.
      const ccx = Math.round(mouseX / SPACING);
      const ccy = Math.round(mouseY / SPACING);

      const colStart = Math.max(0, Math.floor((mouseX - RADIUS) / SPACING));
      const colEnd = Math.min(cols - 1, Math.ceil((mouseX + RADIUS) / SPACING));
      const rowStart = Math.max(0, Math.floor((mouseY - RADIUS) / SPACING));
      const rowEnd = Math.min(rows - 1, Math.ceil((mouseY + RADIUS) / SPACING));
      const h = DOT_SIZE / 2;
      ctx!.lineWidth = 2;

      for (let i = colStart; i <= colEnd; i++) {
        const x = i * SPACING;
        for (let j = rowStart; j <= rowEnd; j++) {
          const y = j * SPACING;
          const dx = x - mouseX;
          const dy = y - mouseY;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist >= RADIUS) continue;

          const proximity = 1 - dist / RADIUS;

          // Flow line: link this dot to the neighbouring dot ONE orthogonal step
          // closer to the cursor's node, so links travel along the grid (dot to
          // dot to dot) toward the cursor rather than cutting straight across.
          const di = ccx - i;
          const dj = ccy - j;
          if (di !== 0 || dj !== 0) {
            let ni = i;
            let nj = j;
            if (Math.abs(di) >= Math.abs(dj)) ni += Math.sign(di);
            else nj += Math.sign(dj);
            ctx!.strokeStyle = lineColor(x, y, proximity * LINE_ALPHA_MAX * active);
            ctx!.beginPath();
            ctx!.moveTo(x, y);
            ctx!.lineTo(ni * SPACING, nj * SPACING);
            ctx!.stroke();
          }

          // brightened dot
          const dotAlpha = BASE_ALPHA + (HOVER_ALPHA - BASE_ALPHA) * proximity * active;
          ctx!.fillStyle = `rgba(${DOT_COLOR}, ${dotAlpha})`;
          ctx!.fillRect(Math.round(x - h), Math.round(y - h), DOT_SIZE, DOT_SIZE);
        }
      }

      // Final short hop from the cursor's nearest dot to the actual cursor point,
      // so the converging paths meet the pointer.
      const nx = ccx * SPACING;
      const ny = ccy * SPACING;
      const nd = Math.hypot(nx - mouseX, ny - mouseY);
      if (nd < RADIUS) {
        ctx!.strokeStyle = lineColor(mouseX, mouseY, (1 - nd / RADIUS) * LINE_ALPHA_MAX * active);
        ctx!.beginPath();
        ctx!.moveTo(mouseX, mouseY);
        ctx!.lineTo(nx, ny);
        ctx!.stroke();
      }
    }

    function loop() {
      // Decay `active` toward 0 once the pointer has been idle/away for a
      // moment, so connector lines fade rather than vanish.
      const idleFor = performance.now() - lastMoveAt;
      const target = idleFor > 400 ? 0 : 1;
      // fade in quickly, fade out slowly so the lines linger
      active += (target - active) * (target > active ? 0.25 : 0.03);

      drawFrame();

      if (active > 0.01) {
        rafId = requestAnimationFrame(loop);
      } else {
        active = 0;
        drawStatic();
        rafId = null;
      }
    }

    function ensureLoop() {
      if (document.hidden) return;
      if (rafId === null) rafId = requestAnimationFrame(loop);
    }

    if (reduceMotion) {
      // Static dots only — no cursor interaction, no rAF loop.
      resize(true);
      window.addEventListener('resize', () => resize());
      return;
    }

    window.addEventListener('resize', () => resize());
    // element-anchored colour sources (tree, clouds) settle after images load
    window.addEventListener('load', computeSources);

    window.addEventListener(
      'mousemove',
      (e) => {
        mouseX = e.clientX;
        mouseY = e.clientY;
        lastMoveAt = performance.now();
        ensureLoop();
      },
      { passive: true }
    );

    window.addEventListener('mouseleave', () => {
      lastMoveAt = 0; // forces immediate decay start
    });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        if (rafId !== null) {
          cancelAnimationFrame(rafId);
          rafId = null;
        }
      } else if (active > 0.01) {
        ensureLoop();
      }
    });

    resize(true);
  })();
</script>
