---
/**
 * PixelSeam.astro — pixelated dissolve between the Hero art and the plain
 * --surface body below it (ref: cofounder.co's chunky-pixel seam, but at a
 * fine ~3px cell, and deliberately RANDOM/organic rather than a repeating
 * dither pattern).
 *
 * `.pixel-seam` is a zero-height marker sitting exactly on the DOM boundary
 * between <Hero /> and the section that follows it — it consumes no layout
 * space. The <canvas> inside is absolutely positioned to straddle that
 * line: -24px to +24px, i.e. half over the hero's last pixels, half over
 * the surface. Because it's a later sibling than <Hero /> (and Hero creates
 * no z-indexed stacking context), it naturally paints on top of the hero
 * art without needing an explicit z-index.
 *
 * Randomization approach (replaces the old 4x4 Bayer ordered-dither, which
 * read as a visible repeating pattern with a uniform band):
 *  - Each cell's paint decision is a per-cell coin flip (Math.random()),
 *    not a fixed threshold matrix — no repeating structure.
 *  - Coverage PROBABILITY is shaped by two independent factors:
 *      1. A vertical ramp on `t` (0 at the band's top/over-hero edge, 1 at
 *         its bottom/over-surface edge) — coverage grows toward and below
 *         the seam, same intent as before.
 *      2. A horizontal "value noise" multiplier — a sum of 3 sine waves of
 *         x at different frequencies/phases, normalized to 0..1 and
 *         contrast-boosted — that varies slowly across the width. This is
 *         what makes density PATCHY instead of a uniform band: some
 *         horizontal stretches land near 0 (almost no flecks), others near
 *         1 (dense clusters). Two different phase offsets drive the
 *         surface-fleck noise and the hero-fleck noise so their sparse/
 *         dense regions don't line up 1:1.
 *  - Overall probabilities are kept low (see SURFACE_MAX / HERO_MAX below)
 *    so the result reads as scattered flecks with real empty space between
 *    them, not a solid dithered fill.
 *
 * Two effects, both driven by the above:
 *  1. --surface-colored cells increasingly cover the band as vertical
 *     fraction `t` rises (white "eating into" the image toward the seam
 *     and below).
 *  2. Hero-colored cells — sampled from the real bottom row of
 *     /hero/base.png — scatter down onto the white just below the seam,
 *     fading out with distance, sparser and smaller than the surface
 *     flecks. Falls back to a sandy/stone tone if the image can't be
 *     sampled for any reason.
 * Static: drawn once, redrawn only on resize. Nothing here animates, so
 * prefers-reduced-motion needs no special handling.
 */
const base = import.meta.env.BASE_URL;
const baseSlash = base.endsWith('/') ? base : base + '/';
const heroBaseSrc = `${baseSlash}hero/base.png`;
---

<div class="pixel-seam" aria-hidden="true">
  <canvas id="pixel-seam-canvas" data-pixel-art></canvas>
</div>

<style>
  .pixel-seam {
    position: relative;
    height: 0;
    overflow: visible;
    pointer-events: none;
  }

  #pixel-seam-canvas {
    position: absolute;
    left: 0;
    top: -56px; /* band straddles the boundary: 56px over the hero, 44px below */
    width: 100%;
    height: 100px;
    display: block;
  }
</style>

<script define:vars={{ heroBaseSrc }}>
  (() => {
    const canvas = document.getElementById('pixel-seam-canvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const CELL = 3; // px, CSS space — small, fine-grained flecks
    const SEAM_UP = 56; // px over the hero — the erosion zone
    const SEAM_DOWN = 44; // px below the seam over the surface — the down-scatter
    const BAND_H = SEAM_UP + SEAM_DOWN; // must match the CSS height above
    const SURFACE = '#FBFBF8';
    const FALLBACK_HERO_TONE = '#c9a874'; // sandy/stone parapet tone, if sampling fails
    const HERO_MAX = 0.6; // peak down-scatter probability just below the seam

    const TAU = Math.PI * 2;

    // Low-frequency "value noise": sum of 3 sines at different frequencies
    // + phases, normalized to 0..1, then contrast-boosted (pow) so the
    // result clumps toward the extremes (near-empty / near-dense regions)
    // instead of hovering in the middle everywhere. `phase` offsets let the
    // surface-fleck and hero-fleck noise fields diverge from each other.
    function hNoise(fracX, phase) {
      const a = Math.sin(fracX * TAU * 1.7 + 0.9 + phase);
      const b = Math.sin(fracX * TAU * 3.3 + 3.1 + phase * 1.3);
      const c = Math.sin(fracX * TAU * 5.9 + 5.2 + phase * 0.7);
      const n = a * 0.45 + b * 0.33 + c * 0.22; // weights sum to 1 => n in ~[-1, 1]
      const norm = Math.min(1, Math.max(0, (n + 1) / 2));
      return Math.pow(norm, 2.4); // stronger contrast: more extreme dense/sparse patches
    }

    // 2D low-frequency blob field (varies in BOTH x and y) — produces
    // clustered clumps of flecks (dense blobs with sparse gaps between) rather
    // than a smooth left-to-right density gradient.
    function cluster(fx, fy) {
      const a = Math.sin(fx * TAU * 1.3 + fy * TAU * 0.9 + 0.4);
      const b = Math.sin(fx * TAU * 2.7 - fy * TAU * 1.6 + 2.3);
      const c = Math.sin(fx * TAU * 0.7 + fy * TAU * 2.1 + 4.1);
      const n = a * 0.42 + b * 0.33 + c * 0.25; // ~[-1, 1]
      const norm = Math.max(0, Math.min(1, (n + 1) / 2));
      return Math.pow(norm, 2.2); // clump toward dense/sparse extremes
    }

    // Sampled bottom-edge colors of the hero art, one RGBA quad per source
    // column. Populated once base.png loads; draw() runs again afterward so
    // the down-scatter uses real colors instead of the fallback tone.
    let heroRow = null;
    let heroNaturalWidth = 0;

    function sampleHeroBottomRow() {
      const img = new Image();
      img.onload = () => {
        heroNaturalWidth = img.naturalWidth;
        const off = document.createElement('canvas');
        off.width = Math.max(1, img.naturalWidth);
        off.height = 1;
        const octx = off.getContext('2d');
        if (!octx) return;
        // Draw only the image's bottom-most source row into a 1px-tall canvas.
        octx.drawImage(img, 0, img.naturalHeight - 1, img.naturalWidth, 1, 0, 0, img.naturalWidth, 1);
        try {
          heroRow = octx.getImageData(0, 0, off.width, 1).data;
        } catch {
          heroRow = null; // e.g. blocked by canvas tainting — falls back below
        }
        draw();
      };
      img.onerror = () => {
        heroRow = null;
      };
      img.src = heroBaseSrc;
    }

    function heroColorAt(fracX) {
      if (heroRow && heroNaturalWidth > 0) {
        const sx = Math.min(heroNaturalWidth - 1, Math.max(0, Math.floor(fracX * heroNaturalWidth)));
        const i = sx * 4;
        return `rgb(${heroRow[i]}, ${heroRow[i + 1]}, ${heroRow[i + 2]})`;
      }
      return FALLBACK_HERO_TONE;
    }

    function draw() {
      const rect = canvas.getBoundingClientRect();
      const width = Math.max(1, Math.round(rect.width));
      const dpr = Math.max(1, window.devicePixelRatio || 1);

      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(BAND_H * dpr);
      canvas.style.width = `${width}px`;
      canvas.style.height = `${BAND_H}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, width, BAND_H);

      const cols = Math.ceil(width / CELL);

      for (let y = 0; y < BAND_H; y += CELL) {
        for (let col = 0; col < cols; col++) {
          const x = col * CELL;
          const fracX = width > 0 ? (x + CELL / 2) / width : 0;

          if (y < SEAM_UP) {
            // OVER THE HERO: erode its bottom edge into ragged white. Coverage
            // ramps from ~0 at the top of the band to ~1 right at the seam, and
            // near the seam the horizontal noise is faded out (nb) so the edge
            // is densely broken up everywhere — this is what kills the straight
            // line between the photo and the page.
            const tt = y / SEAM_UP; // 0 at top of band, 1 at the seam
            const pbase = Math.pow(tt, 1.4);
            // clustered 2D blob field drives density: dense clumps in some
            // patches, sparse gaps in others. Less forcing near the seam so a
            // little edge may survive here and there (intended).
            const clump = 0.12 + 1.3 * cluster(fracX, y / BAND_H);
            const nb = tt * tt * 0.5;
            const p = pbase * (clump * (1 - nb) + nb) * 0.62;
            if (Math.random() < p) {
              ctx.fillStyle = SURFACE;
              ctx.fillRect(x, y, CELL, CELL);
            }
          } else {
            // BELOW THE SEAM (over the surface): scatter hero-sampled flecks
            // downward, fading out with distance, clumped by a differently
            // phased noise field so it doesn't mirror the erosion above.
            const td = (y - SEAM_UP) / SEAM_DOWN; // 0 at seam, 1 at band bottom
            const p = Math.pow(1 - td, 1.7) * HERO_MAX * (0.1 + 1.2 * cluster(fracX + 0.37, y / BAND_H)) * 0.6;
            if (Math.random() < p) {
              ctx.fillStyle = heroColorAt(fracX);
              ctx.fillRect(x, y, CELL, CELL);
            }
          }
        }
      }
    }

    let resizeRaf;
    function onResize() {
      if (resizeRaf) cancelAnimationFrame(resizeRaf);
      resizeRaf = requestAnimationFrame(draw);
    }

    draw(); // immediate static paint (hero-scatter uses the fallback tone until sampled)
    sampleHeroBottomRow(); // then redraw once real bottom-row colors are available
    window.addEventListener('resize', onResize);
  })();
</script>
