---
interface Props {
  slug: string;
  title: string;
  emoji: string;
  summary: string;
  tags: string[];
  status: 'live' | 'ongoing' | 'archived' | 'case-study';
}

const { slug, title, emoji, summary, tags, status } = Astro.props;

const base = import.meta.env.BASE_URL;
const href = `${base.endsWith('/') ? base : `${base}/`}work/${slug}/`;

const statusLabel: Record<string, string> = {
  live: 'Live',
  ongoing: 'Ongoing',
  archived: 'Archived',
  'case-study': 'Case study',
};

const statusClass: Record<string, string> = {
  live: 'pill-live',
  ongoing: 'pill-ongoing',
  archived: 'pill-archived',
  'case-study': 'pill-case-study',
};

const tagClass = (tag: string) => {
  const t = tag.toLowerCase();
  if (t === 'ai') return 'pill-ai';
  if (t.includes('climate') || t.includes('impact')) return 'pill-climate';
  return '';
};
---

<a href={href} class="card tile-hover project-tile">
  <div class="project-tile-top">
    <span class="project-emoji" role="img" aria-label={`${title} icon`}>{emoji}</span>
    <span class={`pill ${statusClass[status]}`}>{statusLabel[status]}</span>
  </div>

  <h3 class="project-title">{title}</h3>
  <p class="project-summary">{summary}</p>

  <ul class="project-tags mono-label">
    {
      tags.map((tag) => (
        <li class={`pill ${tagClass(tag)}`}>{tag}</li>
      ))
    }
  </ul>
</a>

<style>
  .project-tile {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 24px;
    text-decoration: none;
    color: var(--ink);
    height: 100%;
  }

  .project-tile-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .project-emoji {
    font-size: 28px;
    line-height: 1;
  }

  .project-title {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 600;
    margin: 0;
  }

  .project-summary {
    font-size: 15px;
    line-height: 1.5;
    color: var(--text-muted);
    margin: 0;
    flex-grow: 1;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .project-tags .pill {
    font-size: 11px;
    padding: 3px 10px;
  }
</style>
