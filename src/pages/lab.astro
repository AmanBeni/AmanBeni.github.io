---
/**
 * /lab — the papercraft version of the homepage. See Paper/LAB-SPEC.md.
 *
 * This page does NOT import BaseLayout or global.css (the pixel theme) — it
 * builds its own minimal head/body so the paper theme's tokens.css owns
 * every custom property on :root without fighting the pixel theme for the
 * same variable names. src/pages/index.astro and every existing component
 * are untouched.
 */
import '../paper/tokens.css';

import PencilFrame from '../paper/components/PencilFrame.astro';
import Hero from '../paper/sections/Hero.astro';
import About from '../paper/sections/About.astro';
import Education from '../paper/sections/Education.astro';
import Work from '../paper/sections/Work.astro';
import Skills from '../paper/sections/Skills.astro';
import Beyond from '../paper/sections/Beyond.astro';
import Contact from '../paper/sections/Contact.astro';

const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Aman Beniwal — Portfolio (Lab: papercraft theme, work in progress)" />
    <meta name="robots" content="noindex" />
    <title>Aman Beniwal · Lab</title>
  </head>
  <body>
    <!-- Page frame: hairline rules inset by --page-inset on all four sides,
         running the full height of the page (see PencilFrame.astro). -->
    <PencilFrame />

    <!-- Slim strip across the very top. The reference site runs a promo line
         here; this is the same band, left empty on purpose. -->
    <div class="site-ticker" data-lab-id="global.ticker" data-lab-kind="flow"
      data-lab-label="Top strip" data-lab-group="Global"
      data-lab-props="paddingTop,paddingBottom,background,color,fontSize">
    </div>

    <!-- Top bar, meli-style: links centred, actions right, one hairline rule
         underneath. Sticky, and transparent so the single page background
         runs straight through it. -->
    <header class="site-header" data-lab-id="global.header" data-lab-kind="flow"
      data-lab-label="Top bar" data-lab-group="Global"
      data-lab-props="paddingTop,paddingBottom,font,color">
      <span class="site-brand-spacer" aria-hidden="true"></span>

      <nav class="site-nav" aria-label="Primary">
        <a href="#about">about</a>
        <a href="#work">work</a>
        <a href="#beyond">beyond</a>
        <a href="#career">cv</a>
      </nav>

      <div class="site-actions">
        <a href="#contact" class="site-contact">get in touch</a>
      </div>
    </header>

    <main id="main">
      <Hero />
      <About />
      <Education />
      <Work />
      <Skills />
      <Beyond />
      <Contact />
    </main>

    <footer class="site-footer">
      <p>&copy; {currentYear} Aman Beniwal · Lab (papercraft theme, work in progress)</p>
    </footer>

    <!-- Editor mount point — Track B attaches here. -->
    <div id="lab-editor-root"></div>

    {
      import.meta.env.DEV && (
        <script>
          // Editor is dev-only and may not exist yet (Track B builds it
          // separately) — guarded so a missing file never breaks the page.
          (async () => {
            try {
              await import('../paper/editor/index.ts');
            } catch (err) {
              console.info('[lab] editor not available yet:', err);
            }
          })();
        </script>
      )
    }

    <style>
      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      /*
        One background for the whole site. Sections do not carry their own
        colour any more; they are separated by a single hairline rule, the
        way the meli site does it. The page sits inset from the window edge
        by --page-inset, so those rules stop just short of the screen edge
        and read as a frame without being a four-sided box.
      */
      body {
        position: relative;
        margin: 0;
        padding-inline: var(--page-inset);
        background-color: var(--paper-tint);
        background-image: var(--paper-stock);
        background-size: cover;
        background-attachment: fixed;
        color: var(--ink);
        font-family: var(--font-body);
        /* 19 Aug 2026: bumped up from 16px — 16 read too small for
           comfortable reading. Section-level copy sizes scale from this. */
        font-size: 18px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      h1,
      h2,
      h3 {
        margin: 0;
      }

      /* Three columns so the links sit dead centre regardless of how wide
         the brand or the actions are. */
      .site-header {
        position: sticky;
        top: 0;
        z-index: 45;
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        padding-block: 20px;
        border-bottom: 1px solid var(--rule);
        background-color: var(--paper-tint);
        background-image: var(--paper-stock);
        background-size: cover;
        background-attachment: fixed;
      }

      /* Slim strip across the very top. The reference site runs a promo
         line here; this is the same band left empty, which reads as a
         weighted rule rather than an empty row. */
      .site-ticker {
        height: 34px;
        border-bottom: 1px solid var(--rule);
      }

      /* Wordmark removed. The spacer holds the left column so the nav stays
         optically centred. */
      .site-brand-spacer {
        display: block;
      }

      .site-nav {
        display: flex;
        gap: 30px;
      }

      /* Italic serif at small size, the way meli sets its nav. Quiet enough
         to stay out of the way of the headline. */
      .site-nav a,
      .site-contact {
        font-family: var(--font-display);
        font-style: italic;
        font-size: 16px;
        letter-spacing: 0;
        text-decoration: none;
        color: var(--ink);
        white-space: nowrap;
      }

      .site-nav a:hover,
      .site-contact:hover {
        text-decoration: underline;
        text-underline-offset: 4px;
      }

      .site-actions {
        justify-self: end;
      }

      .site-footer {
        border-top: 1px solid var(--rule);
        padding-block: 28px;
        text-align: center;
      }

      .site-footer p {
        margin: 0;
        font-family: var(--font-mono);
        font-size: 11.5px;
        letter-spacing: 0.03em;
        color: var(--ink-soft);
      }

      @media (max-width: 700px) {
        .site-header {
          grid-template-columns: auto 1fr;
          row-gap: 12px;
          padding-block: 14px;
        }
        .site-nav {
          grid-column: 1 / -1;
          justify-content: space-between;
          gap: 12px;
        }
        .site-nav a,
        .site-contact {
          font-size: 14px;
        }
      }
    </style>
  </body>
</html>
