---
/**
 * /lab — the papercraft version of the homepage. See Paper/LAB-SPEC.md.
 *
 * This page does NOT import BaseLayout or global.css (the pixel theme) — it
 * builds its own minimal head/body so the paper theme's tokens.css owns
 * every custom property on :root without fighting the pixel theme for the
 * same variable names. src/pages/index.astro and every existing component
 * are untouched.
 */
import '../paper/tokens.css';

// 24 Aug 2026 (mobile queue r2): PencilFrame (an absolutely-positioned overlay
// frame) retired. On iOS Safari its right rule decoupled from the content and
// drifted off past the screen edge — the frame is now a real border on the
// .page-frame wrapper that actually contains the content, so the lines can
// never leave the content edges (see the .page-frame CSS below).
import Hero from '../paper/sections/Hero.astro';
// 20 Aug 2026 (queue r3): ProofTicker import removed (item 37).
import About from '../paper/sections/About.astro';
import Education from '../paper/sections/Education.astro';
import Work from '../paper/sections/Work.astro';
import Skills from '../paper/sections/Skills.astro';
import Beyond from '../paper/sections/Beyond.astro';
import Contact from '../paper/sections/Contact.astro';

const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Aman Beniwal — strategy generalist and AI builder. Selected AI projects, background, and ways to get in touch." />
    <title>Aman Beniwal — Portfolio</title>
  </head>
  <body>
    <!-- 24 Aug 2026 (mobile queue r2): the page frame is now a real border on
         this wrapper. Everything the frame should bound lives inside it, so the
         four rules always sit exactly at the content edges — no absolute
         overlay that can drift on iOS. Fixed overlays (cursor, mobile notice,
         editor) stay OUTSIDE it. -->
    <div class="page-frame">
    <!-- Slim strip across the very top. The reference site runs a promo line
         here; this is the same band, left empty on purpose. -->
    <div class="site-ticker" data-lab-id="global.ticker" data-lab-kind="flow"
      data-lab-label="Top strip" data-lab-group="Global"
      data-lab-props="paddingTop,paddingBottom,background,color,fontSize">
    </div>

    <!-- Top bar, meli-style: links centred, actions right, one hairline rule
         underneath. Sticky, and transparent so the single page background
         runs straight through it. -->
    <header class="site-header" data-lab-id="global.header" data-lab-kind="flow"
      data-lab-label="Top bar" data-lab-group="Global"
      data-lab-props="paddingTop,paddingBottom,font,color">
      <!-- 20 Aug 2026 (queue r2): single centred row of five links, no brand
           spacer, no separate actions block — "get in touch" is just another
           nav link now. -->
      <!-- 24 Aug 2026 (mobile queue): middot separators between links — the
           bare links read as "too close" (esp. on the phone one-row nav).
           Spans, not part of the <a> hit area; aria-hidden so they're skipped
           by screen readers. -->
      <nav class="site-nav" aria-label="Primary">
        <a href="#about">About</a>
        <span class="nav-sep" aria-hidden="true">·</span>
        <a href="#education">Work</a>
        <span class="nav-sep" aria-hidden="true">·</span>
        <a href="#work">Projects</a>
        <span class="nav-sep" aria-hidden="true">·</span>
        <a href="#beyond">Beyond Work</a>
        <span class="nav-sep" aria-hidden="true">·</span>
        <a href="#contact">Get in touch</a>
      </nav>
    </header>

    <main id="main">
      <Hero />
      {/* 20 Aug 2026 (queue r3): ProofTicker element removed (item 37). */}
      <About />
      <Education />
      <Work />
      <Skills />
      <Beyond />
      <Contact />
    </main>

    <footer class="site-footer">
      <p>&copy; {currentYear} Aman Beniwal</p>
    </footer>
    </div><!-- /.page-frame -->

    <!-- 24 Aug 2026 (mobile queue): a small, dismissible notice on phones that
         the mobile layout is still being polished and reads best on a laptop.
         Shown once per browser session (sessionStorage), phones only. -->
    <div id="mobile-notice" class="mobile-notice" role="status" hidden>
      <p class="mobile-notice-text">
        Still polishing the mobile view. This site looks its best on a laptop.
      </p>
      <button type="button" class="mobile-notice-close" aria-label="Dismiss">Got it</button>
    </div>

    <script>
      (() => {
        const el = document.getElementById('mobile-notice');
        if (!el) return;
        const KEY = 'mobile-notice-dismissed';
        const isPhone = window.matchMedia('(max-width: 767px)').matches;
        let seen = false;
        try { seen = sessionStorage.getItem(KEY) === '1'; } catch {}
        if (isPhone && !seen) {
          el.hidden = false;
          // rAF so the entry transition runs from the hidden state.
          requestAnimationFrame(() => el.classList.add('is-visible'));
        }
        const dismiss = () => {
          el.classList.remove('is-visible');
          try { sessionStorage.setItem(KEY, '1'); } catch {}
          setTimeout(() => { el.hidden = true; }, 300);
        };
        el.querySelector('.mobile-notice-close')?.addEventListener('click', dismiss);
      })();
    </script>

    <!-- 20 Aug 2026 (queue r8): flowing custom cursor — a small sketchy
         triangle that eases toward the pointer (see script below). -->
    <div id="flow-cursor" aria-hidden="true">
      <svg viewBox="0 0 40 42" width="34" height="34">
        <!-- Symmetric paper plane, nose up (rotates to face travel). Outer
             wings cream, inner keel panels dark (fold shadow), thin brown edge. -->
        <path class="pl-wing" d="M20 2 L3 34 L15.5 35.5 Z" />
        <path class="pl-wing" d="M20 2 L37 34 L24.5 35.5 Z" />
        <path class="pl-keel" d="M20 2 L15.5 35.5 L20 40 Z" />
        <path class="pl-keel" d="M20 2 L20 40 L24.5 35.5 Z" />
        <path class="pl-line" d="M20 2 L37 34 L24.5 35.5 L20 40 L15.5 35.5 L3 34 Z" />
        <path class="pl-line" d="M20 2 L20 40" />
      </svg>
    </div>

    <!-- 20 Aug 2026 (queue r8): butter-smooth scroll (Lenis) + the flowing
         cursor, driven by ONE shared requestAnimationFrame loop so scroll and
         cursor read as a single motion system. Both bow out for reduced-motion;
         the cursor also bows out on touch. -->
    <script>
      import Lenis from 'lenis';

      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const coarse = window.matchMedia('(pointer: coarse)').matches;

      // Eased scrolling. syncTouch:false leaves native touch scrolling alone;
      // anchors:true lets Lenis ease the #section nav links itself.
      let lenis = null;
      if (!reduce) {
        lenis = new Lenis({
          duration: 1.15,
          // 20 Aug 2026 (queue r9): travel a bit further per wheel notch.
          wheelMultiplier: 1.5,
          smoothWheel: true,
          syncTouch: false,
          anchors: true,
        });
      }

      // Flowing cursor.
      const cursor = document.getElementById('flow-cursor');
      const useCursor = !!cursor && !coarse && !reduce;
      let tx = 0, ty = 0, cx = 0, cy = 0, moved = false;
      // Facing angle: 0deg = nose up. Turns to face the direction of travel.
      let angle = 0, targetAngle = 0;

      if (useCursor) {
        window.addEventListener('mousemove', (e) => {
          tx = e.clientX; ty = e.clientY;
          if (!moved) {
            cx = tx; cy = ty; moved = true;
            cursor.classList.add('is-visible');
          }
        }, { passive: true });

        const root = document.documentElement;
        root.addEventListener('mouseleave', () => cursor.classList.remove('is-visible'));
        root.addEventListener('mouseenter', () => { if (moved) cursor.classList.add('is-visible'); });

        // Over a clickable element: hide the paper cursor so only the native
        // hand pointer shows (see .over-link CSS).
        document.addEventListener('mouseover', (e) => {
          const hit = (e.target instanceof Element) &&
            e.target.closest('a, button, [role="button"], input, textarea, select, label, summary');
          cursor.classList.toggle('over-link', !!hit);
        });
      }

      function raf(time) {
        if (lenis) lenis.raf(time);
        if (useCursor) {
          // Direction comes from the eased (rendered → target) vector, which is
          // inherently smooth — no per-event jitter. Only re-aim while actually
          // travelling, so a resting cursor doesn't spin.
          const dx = tx - cx, dy = ty - cy;
          if (dx * dx + dy * dy > 12) {
            targetAngle = Math.atan2(dy, dx) * 180 / Math.PI + 90;
          }
          let diff = ((targetAngle - angle + 540) % 360) - 180;
          angle += diff * 0.12; // gentle turn
          cx += dx * 0.15;
          cy += dy * 0.15;
          cursor.style.transform =
            `translate3d(${cx}px, ${cy}px, 0) rotate(${angle}deg)`;
        }
        requestAnimationFrame(raf);
      }
      if (lenis || useCursor) requestAnimationFrame(raf);
    </script>

    <!-- Editor mount point — Track B attaches here. -->
    <div id="lab-editor-root"></div>

    {
      import.meta.env.DEV && (
        <script>
          // Editor is dev-only and may not exist yet (Track B builds it
          // separately) — guarded so a missing file never breaks the page.
          (async () => {
            try {
              await import('../paper/editor/index.ts');
            } catch (err) {
              console.info('[lab] editor not available yet:', err);
            }
          })();
        </script>
      )
    }

    <style>
      * {
        box-sizing: border-box;
      }

      /* 20 Aug 2026 (queue r8): native smooth-scroll OFF — Lenis drives eased
         scrolling now (the two fight each other if both are on). */
      /* 24 Aug 2026 (mobile queue): hard guard against horizontal scroll. In
         Chrome emulation the page never overflows (every stray decor/photo
         sits inside an overflow:hidden section), but on real iOS Safari the
         page was scrolling sideways — which shoved the right-hand PencilFrame
         rule (position:absolute against <body>) off past the screen edge.
         overflow-x:hidden on the root stops the page from ever scrolling
         horizontally, so the frame always reads as a clean inset border. */
      html {
        scroll-behavior: auto;
        overflow-x: hidden;
      }

      /* Flowing custom cursor: a small hand-drawn paper triangle that eases
         toward the pointer and turns to face the way it's moving. Only takes
         over on real mice/trackpads. !important on every element so the native
         cursor never flickers back over links (queue r9). */
      @media (any-hover: hover) and (pointer: fine) {
        *,
        *::before,
        *::after {
          cursor: none !important;
        }
        /* Over clickable things: show the native hand pointer instead (and the
           paper cursor hides itself — see .over-link below), so it's never
           both at once. Matches the reference site. */
        a,
        a *,
        button,
        button *,
        [role='button'],
        input,
        textarea,
        select,
        label,
        summary {
          cursor: pointer !important;
        }
      }

      #flow-cursor {
        position: fixed;
        top: 0;
        left: 0;
        width: 30px;
        height: 30px;
        margin: -15px 0 0 -15px;
        pointer-events: none;
        z-index: 9999;
        opacity: 0;
        transition: opacity 0.25s ease;
        will-change: transform;
        transform: translate3d(-100px, -100px, 0);
        /* Soft lift so the brown plane reads on cream and dark grounds alike. */
        filter: drop-shadow(0 1px 1.5px rgba(28, 20, 12, 0.35));
      }


      #flow-cursor.is-visible {
        opacity: 0.9;
      }

      /* Over a clickable element the native hand takes over, so hide the
         paper cursor to avoid showing two cursors at once. */
      #flow-cursor.over-link {
        opacity: 0;
      }

      /* Symmetric paper plane (Aman's reference): outer wings in normal cream,
         the two inner keel panels darker for the fold shadow, thin brown
         definition. */
      #flow-cursor .pl-wing {
        fill: var(--paper-tint);
      }
      #flow-cursor .pl-keel {
        fill: #c4b79c;
      }
      #flow-cursor .pl-line {
        fill: none;
        stroke: var(--ink);
        stroke-width: 1px;
        stroke-linejoin: round;
        stroke-linecap: round;
      }

      /* No custom cursor on touch or for reduced-motion users. */
      @media (pointer: coarse), (prefers-reduced-motion: reduce) {
        #flow-cursor {
          display: none;
        }
      }

      /*
        One background for the whole site. Sections do not carry their own
        colour any more; they are separated by a single hairline rule, the
        way the meli site does it. The page sits inset from the window edge
        by --page-inset, so those rules stop just short of the screen edge
        and read as a frame without being a four-sided box.
      */
      body {
        position: relative;
        margin: 0;
        background-color: var(--paper-tint);
        background-image: var(--paper-stock);
        background-size: cover;
        background-attachment: fixed;
        color: var(--ink);
        font-family: var(--font-body);
        /* 19 Aug 2026: bumped up from 16px — 16 read too small for
           comfortable reading. Section-level copy sizes scale from this. */
        font-size: 18px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      /* 24 Aug 2026 (mobile queue r2): THE page frame. A real hairline border
         inset from each screen edge by --page-inset, wrapping all the content.
         Because the content lives inside this box, the four rules always sit
         exactly at the content edges — unlike the old absolute overlay, which
         drifted off the right edge on iOS. overflow-x:clip means nothing can
         poke out past the side rules (clip, not hidden, so the sticky header
         still sticks to the viewport). */
      .page-frame {
        margin-inline: var(--page-inset);
        border: 1px solid var(--edge);
        overflow-x: clip;
      }

      h1,
      h2,
      h3 {
        margin: 0;
      }

      /* 20 Aug 2026 (queue r2): plain cream paper bar, single centred nav,
         no scroll-flip machinery. */
      .site-header {
        position: sticky;
        top: 0;
        z-index: 45;
        display: flex;
        justify-content: center;
        align-items: center;
        padding-block: 20px;
        border-bottom: 1px solid var(--rule);
        background-color: var(--paper-tint);
        background-image: var(--paper-stock);
        background-size: cover;
        background-attachment: fixed;
      }

      /* Slim strip across the very top. The reference site runs a promo
         line here; this is the same band left empty, which reads as a
         weighted rule rather than an empty row. */
      .site-ticker {
        height: var(--page-inset);
        border-bottom: 1px solid var(--rule);
      }

      /* 20 Aug 2026 (queue r2): one centred row, evenly spaced. */
      /* 24 Aug 2026 (mobile queue): gap tightened from 40px because the middot
         separators (.nav-sep) now sit between links and carry their own
         breathing room — the effective link-to-link space is gap + dot + gap. */
      .site-nav {
        display: flex;
        justify-content: center;
        align-items: baseline;
        gap: 16px;
      }

      /* 24 Aug 2026 (mobile queue): the middot divider between nav links. */
      .nav-sep {
        color: var(--ink-soft);
        font-size: 15px;
        line-height: 1;
        user-select: none;
        pointer-events: none;
      }

      /* 20 Aug 2026 (queue): Satoshi (the body sans), not the italic serif. */
      .site-nav a {
        font-family: var(--font-body);
        font-size: 15px;
        letter-spacing: 0;
        text-decoration: none;
        color: var(--ink);
        white-space: nowrap;
      }

      .site-nav a:hover {
        text-decoration: underline;
        text-underline-offset: 4px;
      }

      /* 24 Aug 2026 (mobile queue): the "still polishing mobile" notice. A
         low, paper-card toast pinned to the bottom, cream stock + hairline to
         match the theme. Hidden by default; the script reveals it on phones
         and slides it up. */
      .mobile-notice {
        position: fixed;
        left: 12px;
        right: 12px;
        bottom: 12px;
        z-index: 9998;
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 13px 15px;
        border: 1px solid var(--rule);
        border-radius: 6px;
        background-color: var(--paper-tint);
        background-image: var(--paper-stock);
        background-size: cover;
        box-shadow: 2px 6px 20px rgba(28, 20, 12, 0.22);
        /* Start just off the bottom; .is-visible eases it in. */
        transform: translateY(140%);
        opacity: 0;
        transition: transform 0.32s ease, opacity 0.32s ease;
      }

      .mobile-notice.is-visible {
        transform: translateY(0);
        opacity: 1;
      }

      /* Keep the [hidden] attribute authoritative — the display:flex above
         would otherwise win over it (dismissed / desktop = fully removed). */
      .mobile-notice[hidden] {
        display: none;
      }

      .mobile-notice-text {
        margin: 0;
        flex: 1 1 auto;
        font-family: var(--font-body);
        font-size: 13.5px;
        line-height: 1.4;
        color: var(--ink);
      }

      .mobile-notice-close {
        flex: none;
        padding: 8px 14px;
        border: 1px solid var(--rule);
        border-radius: 5px;
        background: transparent;
        font-family: var(--font-body);
        font-size: 12.5px;
        color: var(--ink);
        cursor: pointer;
      }

      .site-footer {
        border-top: 1px solid var(--rule);
        padding-block: 28px;
        text-align: center;
      }

      .site-footer p {
        margin: 0;
        font-family: var(--font-mono);
        font-size: 11.5px;
        letter-spacing: 0.03em;
        color: var(--ink-soft);
      }

      /* 20 Aug 2026 (mobile): nav wraps onto two centred rows instead of
         cramming five links edge-to-edge; header gets its own horizontal
         padding so links never sit flush against the screen edge even
         though body already carries --page-inset. */
      @media (max-width: 767px) {
        .site-header {
          padding-block: 14px;
          padding-inline: 12px;
        }
        .site-nav {
          flex-wrap: wrap;
          row-gap: 8px;
          column-gap: 10px;
        }
        .site-nav a {
          font-size: 13.5px;
        }
        .nav-sep {
          font-size: 13.5px;
        }
      }

      /* 20 Aug 2026 (mobile): at 480px and below, --page-inset (16px) plus
         its own border eats a lot of a 375/320px viewport; tighten it here
         only (token stays untouched everywhere else) and give the nav a
         touch more breathing room. */
      @media (max-width: 480px) {
        .page-frame {
          margin-inline: 10px;
        }
        .site-header {
          padding-inline: 8px;
        }
        .site-nav {
          column-gap: 8px;
        }
      }
    </style>
  </body>
</html>
