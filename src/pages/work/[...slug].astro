---
/* 20 Aug 2026 (queue r3): re-skinned into the paper theme. Reuses the exact
   same markdown body + project images as before — this is a shell re-skin
   only, not a content redesign. Mirrors the minimal head/body shell from
   src/pages/lab.astro (own <html> shell + tokens.css import, no BaseLayout /
   global.css) so this page shares the paper background, brown ink, and
   paper typography with /lab instead of the pixel theme. */
import { getCollection, render } from 'astro:content';
import '../../paper/tokens.css';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const base = import.meta.env.BASE_URL;
const home = base.endsWith('/') ? base : `${base}/`;

const statusLabel: Record<string, string> = {
  live: 'Live',
  ongoing: 'Ongoing',
  archived: 'Archived',
  'case-study': 'Case study',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={project.data.summary} />
    <title>{project.data.title} · Aman Beniwal</title>
  </head>
  <body>
    <header class="proj-topbar">
      <a href={`${home}#projects`} class="proj-back">&larr; Aman Beniwal</a>
    </header>

    <main id="main">
      <article class="proj-article">
        <header class="proj-header">
          <span class="proj-emoji" role="img" aria-label={`${project.data.title} icon`}>
            {project.data.emoji}
          </span>
          <h1 class="proj-title">{project.data.title}</h1>

          <div class="proj-meta">
            <span class="proj-pill">{statusLabel[project.data.status]}</span>
            <ul class="proj-tags">
              {project.data.tags.map((tag) => <li class="proj-pill">{tag}</li>)}
            </ul>
          </div>
        </header>

        <div class="proj-body">
          <Content />
        </div>

        {
          project.data.images && project.data.images.length > 0 && (
            <div class="proj-shots">
              {project.data.images.map((src) => (
                <img class="proj-shot" src={`${home}${src}`} alt={`${project.data.title} screenshot`} loading="lazy" />
              ))}
            </div>
          )
        }
      </article>
    </main>

    <footer class="proj-footer">
      <p>&copy; {new Date().getFullYear()} Aman Beniwal</p>
    </footer>

    <!-- 1 Sep 2026: render the workflow diagrams. The default markdown
         processor emits a ```mermaid fence as <pre data-language="mermaid">
         (Shiki-highlighted, but textContent is the clean source). We read that
         source and swap in a mermaid SVG themed to the paper palette, so it
         reads as part of the page rather than a stock purple flowchart. -->
    <script>
      import mermaid from 'mermaid';

      const blocks = document.querySelectorAll('pre[data-language="mermaid"]');
      if (blocks.length) {
        mermaid.initialize({
          startOnLoad: false,
          securityLevel: 'strict',
          theme: 'base',
          themeVariables: {
            fontFamily: "'Satoshi', 'Inter', system-ui, sans-serif",
            fontSize: '15px',
            // Paper palette (see src/paper/tokens.css).
            background: 'transparent',
            primaryColor: '#fffdf8', // node fill — paper-card
            primaryTextColor: '#4a3527', // ink
            primaryBorderColor: 'rgba(74,53,39,0.5)', // rule
            secondaryColor: '#f3f2e9', // paper-tint
            tertiaryColor: '#ece7d6', // paper-alt-tint
            lineColor: '#8a4a30', // terracotta — edges
            edgeLabelBackground: '#f3f2e9',
            nodeBorder: 'rgba(74,53,39,0.5)',
            clusterBkg: '#ece7d6',
            titleColor: '#4a3527',
          },
          flowchart: { curve: 'basis', htmlLabels: true, padding: 14, useMaxWidth: true },
        });

        for (const [i, el] of blocks.entries()) {
          const src = el.textContent || '';
          // Drop Shiki's inline dark background/colour so our paper panel shows.
          el.removeAttribute('style');
          try {
            const { svg, bindFunctions } = await mermaid.render(`mmd-${i}`, src);
            el.innerHTML = svg;
            bindFunctions?.(el);
            el.classList.add('mermaid-rendered');
          } catch (err) {
            console.error('[mermaid] render failed:', err);
            // Leave the (styled) source visible as a graceful fallback.
            el.classList.add('mermaid-failed');
          }
        }
      }
    </script>

    <style>
      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        padding-inline: var(--page-inset);
        background-color: var(--paper-tint);
        background-image: var(--paper-stock);
        background-size: cover;
        background-attachment: fixed;
        color: var(--ink);
        font-family: var(--font-body);
        font-size: 18px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      h1,
      h2,
      h3 {
        margin: 0;
        font-family: var(--font-display);
      }

      .proj-topbar {
        display: flex;
        align-items: center;
        padding: 20px 0;
        border-bottom: 1px solid var(--rule);
      }

      .proj-back {
        color: var(--ink);
        text-decoration: none;
        font-family: var(--font-mono);
        font-size: 14px;
        letter-spacing: 0.02em;
      }

      .proj-back:hover {
        text-decoration: underline;
      }

      .proj-article {
        /* 20 Aug 2026 (queue r12): widened from 760 — too much wasted side space. */
        max-width: 1080px;
        margin: 0 auto;
        padding: 48px 0 64px;
      }

      .proj-header {
        margin-bottom: 40px;
        border-bottom: 1px solid var(--rule);
        padding-bottom: 28px;
      }

      .proj-emoji {
        font-size: 40px;
        display: block;
        margin-bottom: 12px;
      }

      .proj-title {
        font-size: 32px;
        margin: 0 0 16px;
        color: var(--ink);
      }

      .proj-meta {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
      }

      .proj-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .proj-pill {
        display: inline-block;
        padding: 4px 12px;
        border: 1px solid var(--rule);
        border-radius: 999px;
        font-family: var(--font-mono);
        font-size: 12px;
        letter-spacing: 0.02em;
        color: var(--ink-soft);
        background: var(--paper-card);
      }

      .proj-body {
        font-size: 17px;
        line-height: 1.7;
        background: var(--paper-card);
        border: 1px solid var(--rule);
        border-radius: 10px;
        padding: 32px 36px;
      }

      @media (max-width: 640px) {
        .proj-body {
          padding: 22px 20px;
        }
      }

      .proj-body :global(h2) {
        font-size: 22px;
        margin-top: 40px;
        margin-bottom: 12px;
        color: var(--ink);
      }

      .proj-body :global(h3) {
        font-size: 18px;
        margin-top: 28px;
        margin-bottom: 8px;
        color: var(--ink);
      }

      .proj-body :global(p) {
        margin: 0 0 16px;
        color: var(--ink);
      }

      .proj-body :global(ul) {
        margin: 0 0 16px;
        padding-left: 24px;
        list-style: disc;
      }

      .proj-body :global(li) {
        margin-bottom: 6px;
        display: list-item;
      }

      .proj-body :global(li)::marker {
        color: var(--accent);
      }

      .proj-body :global(a) {
        color: var(--accent);
      }

      /* 1 Sep 2026: workflow diagram (mermaid). The markdown fence renders as
         <pre data-language="mermaid"> (Shiki-highlighted source). Before the
         script swaps in the SVG we keep the raw source invisible so no flash of
         diagram code shows; a framed, tinted panel sets it apart from the prose.
         !important beats Shiki's inline background/colour on the <pre>. */
      .proj-body :global(pre[data-language='mermaid']) {
        margin: 8px 0 28px;
        padding: 20px 18px;
        border: 1px solid var(--rule);
        border-radius: 10px;
        background: var(--paper-tint) !important;
        text-align: center;
        overflow-x: auto;
        /* Hide the raw source until the SVG replaces it. */
        color: transparent;
        font-size: 0;
        line-height: 0;
      }

      /* Once the script has swapped in the SVG, reveal it. */
      .proj-body :global(pre[data-language='mermaid'].mermaid-rendered) {
        font-size: initial;
        line-height: initial;
      }

      /* If rendering failed, fall back to showing the source legibly. */
      .proj-body :global(pre[data-language='mermaid'].mermaid-failed) {
        color: var(--ink);
        font-size: 13px;
        line-height: 1.5;
        text-align: left;
      }

      .proj-body :global(pre[data-language='mermaid'] svg) {
        max-width: 100%;
        height: auto;
      }

      /* Small label above the diagram (added at the top of each project body). */
      .proj-body :global(.proj-flow-label) {
        margin: 4px 0 10px;
        font-family: var(--font-mono);
        font-size: 12.5px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--ink-soft);
      }

      .proj-shots {
        margin-top: 40px;
        display: flex;
        flex-direction: column;
        gap: 20px;
      }

      .proj-shot {
        width: 100%;
        height: auto;
        display: block;
        border-radius: 8px;
        border: 1px solid var(--rule);
      }

      .proj-footer {
        text-align: center;
        padding: 24px 0 40px;
        font-family: var(--font-mono);
        font-size: 13px;
        color: var(--ink-soft);
        border-top: 1px solid var(--rule);
      }
    </style>
  </body>
</html>
